---
import Footer from "../components/layout/Footer.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import "../styles/global.css";

const { title = "No Whiteboard Jobs" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <!-- Initialize theme before paint -->
    <script>
      (() => {
        type ThemeName = "light" | "dark";
        type ThemeVars = Record<string, string>;

        const themes = {
          light: {
            "--bg": "#f4f7f8",
            "--surface": "#eef3f5",
            "--text": "#111827",
            "--text-muted": "#6b7280",
            "--border": "#e5e7eb",
            "--accent": "#672d86",
            "--success-bg": "#059669",
            "--success-text": "#347058",
            "--success-border": "#10b981",
            "--warning-bg": "#d97706",
            "--warning-text": "#615323",
            "--warning-border": "#f59e0b",
            "--info-bg": "#0284c7",
            "--info-text": "#224150",
            "--info-border": "#0ea5e9",
          },
          dark: {
            "--bg": "#0a0a0a",
            "--surface": "#1f1f1f",
            "--text": "#e5e7eb",
            "--text-muted": "#9ca3af",
            "--border": "#262626",
            "--accent": "#7fb6ea",
            "--success-bg": "#055296",
            "--success-text": "#6ea0e7",
            "--success-border": "#104eb9",
            "--warning-bg": "#d97706",
            "--warning-text": "#fcd34d",
            "--warning-border": "#f59e0b",
            "--info-bg": "#02c7a0",
            "--info-text": "#8af4e1",
            "--info-border": "#0ee9e9",
          },
        } satisfies Record<ThemeName, ThemeVars>;

        const root = document.documentElement;

        const applyTheme = (theme: string) => {
          const next: ThemeName = theme === "dark" ? "dark" : "light";

          for (const [prop, value] of Object.entries(themes[next])) {
            root.style.setProperty(prop, value);
          }

          root.classList.toggle("dark", next === "dark");
          root.dataset.theme = next;
          return next;
        };

        // Expose helpers for other components (e.g., theme toggle button)
        window.__setTheme = (theme: string) => {
          const next = applyTheme(theme);
          try {
            localStorage.setItem("theme", next);
          } catch {
            // ignore
          }
          return next;
        };

        window.__toggleTheme = () => {
          const current = root.classList.contains("dark") ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          if (typeof window.__setTheme === "function")
            return window.__setTheme(next);
          return applyTheme(next);
        };

        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");

        applyTheme(theme);
      })();
    </script>
  </head>
  <body
    class="min-h-screen antialiased bg-bg-light text-text-light dark:bg-bg-dark dark:text-text-dark"
  >
    <!-- Skip link for keyboard and screen reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 rounded bg-bg-dark px-4 py-2 text-sm text-text-dark focus-visible:ring-2 focus-visible:ring-accent"
    >
      Skip to content
    </a>

    <!-- App frame -->
    <div class="flex min-h-screen">
      <Sidebar />
      <main id="main" class="flex flex-col flex-1 min-w-0">
        <!-- Page content -->
        <div class="flex-1 py-10">
          <div class="max-w-7xl mx-auto px-8 w-full">
            <slot />
          </div>
        </div>
        <!-- Footer (full-width background, constrained content inside) -->
        <Footer />
      </main>
    </div>
  </body>
</html>
