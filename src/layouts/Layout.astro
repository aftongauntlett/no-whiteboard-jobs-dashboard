---
import Footer from "../components/layout/Footer.astro";
import MobileHeader from "../components/layout/MobileHeader.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import "../styles/global.css";

const { title = "No Whiteboard Jobs" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <!-- Pre-paint background + color-scheme to avoid white flash during navigation -->
    <style is:inline>
      html {
        background-color: #f4f7f8;
        color-scheme: light;
      }

      @media (prefers-color-scheme: dark) {
        html {
          background-color: #0a0a0a;
          color-scheme: dark;
        }
      }

      html.dark {
        background-color: #0a0a0a;
        color-scheme: dark;
      }
    </style>

    <!-- Initialize theme before paint (must be inline + synchronous) -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const STORAGE_KEY = "theme";
        const TRANSITION_CLASS = "theme-transitioning";
        const TRANSITION_MS = 200;

        let transitionTimeoutId = null;

        const withThemeTransition = (fn) => {
          // Avoid accumulating timeouts on rapid toggles.
          if (transitionTimeoutId) window.clearTimeout(transitionTimeoutId);

          root.classList.add(TRANSITION_CLASS);
          // Force a style flush so the transition class is applied
          // before we update theme variables.
          root.getBoundingClientRect();

          const result = fn();

          transitionTimeoutId = window.setTimeout(() => {
            root.classList.remove(TRANSITION_CLASS);
            transitionTimeoutId = null;
          }, TRANSITION_MS + 50);

          return result;
        };

        const applyTheme = (theme) => {
          const next = theme === "dark" ? "dark" : "light";
          root.classList.toggle("dark", next === "dark");
          root.dataset.theme = next;
          root.style.colorScheme = next;
          return next;
        };

        // Expose helpers for other components (e.g., theme toggle button)
        window.__setTheme = (theme) => {
          const next = withThemeTransition(() => applyTheme(theme));
          try {
            localStorage.setItem(STORAGE_KEY, next);
          } catch {
            // ignore
          }
          return next;
        };

        window.__toggleTheme = () => {
          const current = root.classList.contains("dark") ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          if (typeof window.__setTheme === "function")
            return window.__setTheme(next);
          return withThemeTransition(() => applyTheme(next));
        };

        let stored = null;
        try {
          stored = localStorage.getItem(STORAGE_KEY);
        } catch {
          // ignore
        }

        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        applyTheme(theme);
      })();
    </script>
  </head>
  <body
    class="min-h-screen antialiased bg-bg-light text-text-light dark:bg-bg-dark dark:text-text-dark"
  >
    <!-- Skip link for keyboard and screen reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 rounded bg-bg-dark px-4 py-2 text-sm text-text-dark focus-visible:ring-2 focus-visible:ring-accent"
    >
      Skip to content
    </a>

    <!-- App frame -->
    <div class="flex min-h-screen">
      <div class="hidden md:block">
        <Sidebar />
      </div>
      <main id="main" class="flex flex-col flex-1 min-w-0">
        <MobileHeader />
        <!-- Page content -->
        <div class="flex-1 py-10">
          <div class="app-container">
            <slot />
          </div>
        </div>
        <!-- Footer (full-width background, constrained content inside) -->
        <Footer />
      </main>
    </div>
  </body>
</html>
