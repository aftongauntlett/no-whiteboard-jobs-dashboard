---
import companies from "../../data/companies";

import { COMPANIES_PER_PAGE, DEFAULT_PAGE } from "../../config/pagination";
import { paginateArray } from "../../utils/pagination";

export async function getStaticPaths() {
  const totalPages = Math.ceil(companies.length / COMPANIES_PER_PAGE);
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({ params: { page: i.toString() } });
  }
  return paths;
}

import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import CompaniesBrowseSection from "../../components/company/CompaniesBrowseSection.astro";
import type { Company } from "@data/types";

import companiesViewToggleUrl from "../../scripts/companiesViewToggle.ts?url";
import companiesBrowseClientUrl from "../../scripts/companiesBrowseClient.ts?url";

const pageNum = parseInt(Astro.params.page);
const resolvedPageNum = Number.isFinite(pageNum) ? pageNum : DEFAULT_PAGE;

const pageSize = COMPANIES_PER_PAGE;
const totalItems = (companies as Company[]).length;
const {
  paginatedItems,
  totalPages,
  currentPage: validatedPage,
} = paginateArray(companies as Company[], resolvedPageNum, pageSize);

const startIndex = (validatedPage - 1) * pageSize + 1;
const endIndex = startIndex + paginatedItems.length - 1;
---

<Layout
  title={`No Whiteboard Jobs - Page ${validatedPage}`}
  description={`Browse companies that hire without whiteboard-style interviews (page ${validatedPage}).`}
>
  <PageHeader
    title="No Whiteboard Jobs"
    subtitle="Companies that hire without whiteboard-style interviews."
  />
  <CompaniesBrowseSection
    paginatedItems={paginatedItems}
    totalPages={totalPages}
    currentPage={validatedPage}
    totalItems={totalItems}
    startIndex={startIndex}
    endIndex={endIndex}
    companiesViewToggleUrl={companiesViewToggleUrl}
    companiesBrowseClientUrl={companiesBrowseClientUrl}
  />
</Layout>
