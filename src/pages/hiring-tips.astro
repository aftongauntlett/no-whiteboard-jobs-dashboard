---
import FileCheck from "lucide-astro/FileCheck";
import FileX from "lucide-astro/FileX";
import ExternalLink from "lucide-astro/ExternalLink";
import MessagesSquare from "lucide-astro/MessagesSquare";
import Newspaper from "lucide-astro/Newspaper";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Button from "../components/ui/Button.astro";
import ResourceCard from "../components/ui/ResourceCard.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";
---

<Layout
  title="Hiring Tips"
  description="Resources, discussions, and articles on alternatives to whiteboard-style interviews."
>
  <PageHeader
    title="Hiring Tips"
    subtitle="Articles, discussions, and resources on alternatives to whiteboard-style interviews."
  />

  <!-- Main content -->
  <section class="space-y-8">
    <!-- External resources -->
    <div>
      <h2 class="text-xl font-semibold mb-6">External Resources</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <ResourceCard
          title="They Whiteboarded Me"
          icon={FileX}
          tone="secondary"
          iconClass="text-coral"
        >
          <p class="pb-4">
            A community list of interview experiences. Some are great, some are
            rough. It’s useful when you want a heads up on what a process is
            like before you spend a bunch of time on it.
          </p>
          <div slot="footer" class="flex items-center justify-end">
            <Button
              href="https://they.whiteboarded.me/"
              target="_blank"
              variant="primary"
              tone="outline"
            >
              Visit Website
            </Button>
          </div>
        </ResourceCard>
        <ResourceCard
          title="Hiring Without Whiteboards"
          icon={FileCheck}
          tone="primary"
        >
          <p class="pb-4">
            This is the upstream repo that powers the company list on this site.
            Huge credit to the folks maintaining it. The idea is simple, keep a
            public list of teams that don’t lean on CS trivia, puzzles, or
            gotcha questions as the main filter.
          </p>
          <div slot="footer" class="flex items-center justify-end">
            <Button
              href="https://github.com/poteto/hiring-without-whiteboards"
              target="_blank"
              variant="primary"
              tone="outline"
            >
              View GitHub repository
            </Button>
          </div>
        </ResourceCard>
      </div>

      <!-- Discussions + articles (progressive disclosure) -->
      <div class="mt-8">
        <Accordion
          title="Discussions & Articles"
          description="Expand for links to community discussions and longer-form reading."
        >
          <AccordionItem title="Discussions" icon={MessagesSquare}>
            <p
              class="ui-muted-body text-sm text-text-mutedLight dark:text-text-mutedDark"
            >
              A couple threads where people argue about hiring, share stories,
              and trade ideas.
            </p>

            <ul class="mt-3 space-y-2">
              <li>
                <div
                  class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
                >
                  <a
                    href="https://news.ycombinator.com/item?id=13874026"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-w-0 items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    <span
                      class="min-w-0 truncate sm:whitespace-normal sm:overflow-visible"
                    >
                      HackerNews (2017)
                    </span>
                    <ExternalLink class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </a>
                  <span
                    class="ui-muted-body hidden shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark sm:inline"
                  >
                    Original thread
                  </span>
                </div>
              </li>
              <li>
                <div
                  class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
                >
                  <a
                    href="https://news.ycombinator.com/item?id=23981795"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-w-0 items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    <span
                      class="min-w-0 truncate sm:whitespace-normal sm:overflow-visible"
                    >
                      HackerNews (2020)
                    </span>
                    <ExternalLink class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </a>
                  <span
                    class="ui-muted-body hidden shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark sm:inline"
                  >
                    Follow-up thread
                  </span>
                </div>
              </li>
            </ul>
          </AccordionItem>

          <AccordionItem title="Articles" icon={Newspaper}>
            <p
              class="ui-muted-body text-sm text-text-mutedLight dark:text-text-mutedDark"
            >
              Longer reads on interviewing without whiteboards.
            </p>

            <ul class="mt-3 space-y-2">
              <li>
                <div
                  class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
                >
                  <a
                    href="https://theoutline.com/post/1256/finding-a-better-alternative-to-the-whiteboard-interview"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-w-0 items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    <span
                      class="min-w-0 truncate sm:whitespace-normal sm:overflow-visible"
                    >
                      Finding a better alternative to the whiteboard interview
                    </span>
                    <ExternalLink class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </a>
                  <span
                    class="ui-muted-body hidden shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark sm:inline"
                  >
                    Tolulope Edionwe · Long-form
                  </span>
                </div>
              </li>
              <li>
                <div
                  class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
                >
                  <a
                    href="https://jes.al//2023/03/how-to-hire-engineering-talent-without-the-bs/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-w-0 items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    <span
                      class="min-w-0 truncate sm:whitespace-normal sm:overflow-visible"
                    >
                      How to hire engineering talent without the BS
                    </span>
                    <ExternalLink class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </a>
                  <span
                    class="ui-muted-body hidden shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark sm:inline"
                  >
                    Jesal Gadhia · Practical guide
                  </span>
                </div>
              </li>
              <li>
                <div
                  class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
                >
                  <a
                    href="http://www.aaronsw.com/weblog/hiring.en"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-w-0 items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    <span
                      class="min-w-0 truncate sm:whitespace-normal sm:overflow-visible"
                    >
                      How I Hire Programmers
                    </span>
                    <ExternalLink class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </a>
                  <span
                    class="ui-muted-body hidden shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark sm:inline"
                  >
                    Aaron Swartz · Classic essay
                  </span>
                </div>
              </li>
            </ul>
          </AccordionItem>
        </Accordion>
      </div>
    </div>
  </section>
</Layout>
