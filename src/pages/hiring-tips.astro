---
import FileCheck from "lucide-astro/FileCheck";
import FileX from "lucide-astro/FileX";
import ExternalLink from "lucide-astro/ExternalLink";
import MessagesSquare from "lucide-astro/MessagesSquare";
import Newspaper from "lucide-astro/Newspaper";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Button from "../components/ui/Button.astro";
import ResourceCard from "../components/ui/ResourceCard.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";
---

<Layout title="Hiring Tips">
  <PageHeader
    title="Hiring Tips"
    subtitle="Articles, discussions, and resources on alternatives to whiteboard-style interviews."
  />

  <!-- Main content -->
  <section class="space-y-8">
    <!-- External resources -->
    <div>
      <h2 class="text-xl font-semibold mb-6">External Resources</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <ResourceCard
          title="They Whiteboarded Me"
          icon={FileX}
          tone="secondary"
          iconClass="text-coral"
        >
          <p>
            A crowd-sourced and curated list of companies and their interview
            practices, both good and bad. It helps job seekers understand what
            an interview process actually looks like ahead of time, so they can
            focus on roles that are a good fit.
          </p>
          <div slot="footer" class="flex items-center justify-end">
            <Button
              href="https://they.whiteboarded.me/"
              target="_blank"
              variant="primary"
              style="outline"
            >
              Visit Website
            </Button>
          </div>
        </ResourceCard>

        <ResourceCard
          title="Hiring Without Whiteboards"
          icon={FileCheck}
          tone="primary"
        >
          <p>
            The original open-source project this frontend is built on. It
            maintains a list of companies that avoid interview processes focused
            on CS trivia, puzzles, and gotcha questions, and instead emphasize
            real, day-to-day engineering work.
          </p>
          <div slot="footer" class="flex items-center justify-end">
            <Button
              href="https://github.com/poteto/hiring-without-whiteboards"
              target="_blank"
              variant="primary"
              style="outline"
            >
              View GitHub repository
            </Button>
          </div>
        </ResourceCard>
      </div>
    </div>

    <!-- Discussions + articles (progressive disclosure) -->
    <Accordion
      title="Discussions & Articles"
      description="Expand for links to community discussions and longer-form reading."
    >
      <AccordionItem title="Discussions" icon={MessagesSquare}>
        <p class="text-sm text-text-mutedLight dark:text-text-mutedDark">
          Community discussions on alternative hiring practices.
        </p>

        <ul class="mt-3 space-y-2">
          <li>
            <div class="flex items-start justify-between gap-4">
              <a
                href="https://news.ycombinator.com/item?id=13874026"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
              >
                HackerNews (2017)
                <ExternalLink class="h-5 w-5" aria-hidden="true" />
              </a>
              <span
                class="shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark"
              >
                Original thread
              </span>
            </div>
          </li>
          <li>
            <div class="flex items-start justify-between gap-4">
              <a
                href="https://news.ycombinator.com/item?id=23981795"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
              >
                HackerNews (2020)
                <ExternalLink class="h-5 w-5" aria-hidden="true" />
              </a>
              <span
                class="shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark"
              >
                Follow-up thread
              </span>
            </div>
          </li>
        </ul>
      </AccordionItem>

      <AccordionItem title="Articles" icon={Newspaper}>
        <p class="text-sm text-text-mutedLight dark:text-text-mutedDark">
          Articles and blog posts on hiring without whiteboards.
        </p>

        <ul class="mt-3 space-y-2">
          <li>
            <div class="flex items-start justify-between gap-4">
              <a
                href="https://theoutline.com/post/1256/finding-a-better-alternative-to-the-whiteboard-interview"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
              >
                Finding a better alternative to the whiteboard interview
                <ExternalLink class="h-5 w-5" aria-hidden="true" />
              </a>
              <span
                class="shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark"
              >
                Tolulope Edionwe · Long-form
              </span>
            </div>
          </li>
          <li>
            <div class="flex items-start justify-between gap-4">
              <a
                href="https://jes.al//2023/03/how-to-hire-engineering-talent-without-the-bs/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
              >
                How to hire engineering talent without the BS
                <ExternalLink class="h-5 w-5" aria-hidden="true" />
              </a>
              <span
                class="shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark"
              >
                Jesal Gadhia · Practical guide
              </span>
            </div>
          </li>
          <li>
            <div class="flex items-start justify-between gap-4">
              <a
                href="http://www.aaronsw.com/weblog/hiring.en"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
              >
                How I Hire Programmers
                <ExternalLink class="h-5 w-5" aria-hidden="true" />
              </a>
              <span
                class="shrink-0 text-xs text-text-mutedLight dark:text-text-mutedDark"
              >
                Aaron Swartz · Classic essay
              </span>
            </div>
          </li>
        </ul>
      </AccordionItem>
    </Accordion>
  </section>
</Layout>
