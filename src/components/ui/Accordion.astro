---
export type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props as Props;
---

<article
  class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark overflow-hidden"
>
  <div class="px-6 py-5">
    <h3
      class="text-lg font-semibold leading-tight capitalize text-text-light dark:text-text-dark"
    >
      {title}
    </h3>
    {
      description && (
        <p class="mt-1 text-sm text-text-mutedLight dark:text-text-mutedDark">
          {description}
        </p>
      )
    }
  </div>

  <slot />
</article>
