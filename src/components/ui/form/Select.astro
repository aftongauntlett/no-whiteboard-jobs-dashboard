---
import { controlBaseClass } from "./formStyles";

type Props = {
  id: string;
  name: string;
  describedBy?: string;
  required?: boolean;
  class?: string;
};

const {
  id,
  name,
  describedBy,
  required = false,
  class: className,
} = Astro.props as Props;

const classes =
  `${controlBaseClass} appearance-none pr-10 ${className ?? ""}`.trim();
---

<div class="relative">
  <select
    id={id}
    name={name}
    required={required}
    class={classes}
    aria-describedby={describedBy}
    data-control
  >
    <slot />
  </select>

  <svg
    class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-mutedLight dark:text-text-mutedDark"
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 1 1 1.06 1.06l-4.24 4.24a.75.75 0 0 1-1.06 0L5.21 8.29a.75.75 0 0 1 .02-1.08Z"
      clip-rule="evenodd"></path>
  </svg>
</div>
