---
import Badge from "./Badge.astro";
import type { EmploymentType } from "@data/types";
import { employmentBadgeVariant } from "../company/companyStyles";

interface Props {
  employmentType: EmploymentType;
}

const { employmentType } = Astro.props;
---

<Badge variant={employmentBadgeVariant(employmentType)}>
  {employmentType}
</Badge>
