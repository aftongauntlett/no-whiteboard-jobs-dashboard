---
import Button from "./Button.astro";
import Field from "./form/Field.astro";
import TextInput from "./form/TextInput.astro";
import Textarea from "./form/Textarea.astro";
import { errorSummaryClass } from "./form/formStyles";
import Lightbulb from "lucide-astro/Lightbulb";

const action = "https://formspree.io/f/xgoobynr";
const turnstileSiteKey = String(
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
    import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY ||
    import.meta.env.TURNSTILE_SITE_KEY ||
    process.env.PUBLIC_TURNSTILE_SITE_KEY ||
    process.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY ||
    process.env.TURNSTILE_SITE_KEY ||
    "",
).trim();
---

<form
  action={action}
  method="POST"
  novalidate
  class="ui-hover-brighten-body group rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark overflow-hidden"
  data-resource-suggestion-form
>
  <input type="hidden" name="type" value="Resource page suggestion" />

  <header
    class="flex items-center gap-3 px-5 py-4 border-b border-divider-surface"
  >
    <Lightbulb class="h-6 w-6 text-accent shrink-0" aria-hidden="true" />
    <h2
      class="text-lg font-bold leading-tight text-text-light dark:text-text-dark transition-colors group-hover:text-accent"
    >
      Suggest a Resource
    </h2>
  </header>

  <div class="p-5 space-y-4">
    <p
      class="ui-muted-body text-sm leading-relaxed text-text-mutedLight dark:text-text-mutedDark"
    >
      Know an article, study, or tool that belongs on this page? Share it here.
      I review everything and add what fits.
    </p>

    <div
      data-resource-validation-summary
      hidden
      role="alert"
      aria-live="polite"
      tabindex="-1"
      class={errorSummaryClass}
    >
      <p class="m-0 font-medium">Please fix the highlighted fields.</p>
      <ul
        class="mt-2 list-disc pl-5 space-y-1"
        data-resource-validation-summary-list
      >
      </ul>
    </div>

    <!-- Honeypot (spam trap) -->
    <div class="sr-only" aria-hidden="true">
      <label for="resource-suggestion-gotcha">Leave this field empty</label>
      <input
        type="text"
        name="_gotcha"
        id="resource-suggestion-gotcha"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      <Field
        id="resource-email"
        label="Email"
        hint="Optional — only if you'd like a reply"
      >
        <TextInput
          slot="control"
          id="resource-email"
          name="email"
          type="email"
          autocomplete="email"
          describedBy="resource-email-hint resource-email-error"
        />
      </Field>

      <Field id="resource-url" label="Link to the resource" required>
        <TextInput
          slot="control"
          id="resource-url"
          name="resourceUrl"
          type="url"
          placeholder="https://..."
          required
          describedBy="resource-url-error"
        />
      </Field>

      <Field
        id="resource-message"
        label="Why does this belong here?"
        required
        hint="A sentence or two is plenty"
        class="md:col-span-2"
      >
        <Textarea
          slot="control"
          id="resource-message"
          name="message"
          required
          rows={4}
          describedBy="resource-message-hint resource-message-error"
        />
      </Field>
    </div>

    <div
      class="space-y-2"
      data-turnstile-widget
      aria-label="Human verification"
    >
      {
        turnstileSiteKey ? (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="auto"
          />
        ) : (
          <p class="text-sm text-warning-text">
            Human verification is unavailable right now. Please try again later.
          </p>
        )
      }
    </div>

    <div
      data-resource-success
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-success-border bg-success-bg/10 p-4 text-sm text-success-text"
    >
      Thanks — your suggestion was sent.
    </div>

    <div
      data-resource-error
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-warning-border bg-warning-bg/10 p-4 text-sm text-warning-text"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="m-0" data-resource-error-text>
          Something went wrong. Please try again later.
        </p>
        <button
          type="button"
          class="underline underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
          data-resource-retry
        >
          Try again
        </button>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <Button variant="primary" tone="solid" type="submit" data-resource-submit>
        Send suggestion
      </Button>
    </div>
  </div>
</form>

{
  turnstileSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script is:inline>
  (() => {
    const form = document.querySelector("[data-resource-suggestion-form]");
    if (!form) return;

    const successEl = form.querySelector("[data-resource-success]");
    const errorEl = form.querySelector("[data-resource-error]");
    const errorTextEl = form.querySelector("[data-resource-error-text]");
    const retryBtn = form.querySelector("[data-resource-retry]");
    const submitBtn = form.querySelector("[data-resource-submit]");
    const gotchaEl = form.querySelector("#resource-suggestion-gotcha");
    const turnstileWidgetEl = form.querySelector(".cf-turnstile");
    const summaryEl = form.querySelector("[data-resource-validation-summary]");
    const summaryListEl = form.querySelector(
      "[data-resource-validation-summary-list]",
    );

    if (!successEl || !errorEl || !errorTextEl || !submitBtn) return;

    const clearFieldError = (fieldId) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.removeAttribute("aria-invalid");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const setFieldError = (fieldId, message) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.setAttribute("aria-invalid", "true");
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const hideSummary = () => {
      if (!summaryEl || !summaryListEl) return;
      summaryEl.hidden = true;
      summaryListEl.innerHTML = "";
    };

    const hideMessages = () => {
      successEl.hidden = true;
      errorEl.hidden = true;
    };

    const showSuccess = (message) => {
      hideMessages();
      successEl.textContent = message;
      successEl.hidden = false;
      successEl.focus();
    };

    const showError = (message) => {
      hideMessages();
      errorTextEl.textContent = message;
      errorEl.hidden = false;
      errorEl.focus();
    };

    const resetTurnstile = () => {
      const turnstileApi = window.turnstile;
      if (!turnstileApi || typeof turnstileApi.reset !== "function") return;
      try {
        turnstileApi.reset();
      } catch (_err) {
        // Ignore widget reset errors and preserve submit flow.
      }
    };

    const setBusy = (busy) => {
      submitBtn.disabled = busy;
      submitBtn.setAttribute("aria-busy", busy ? "true" : "false");
      submitBtn.textContent = busy ? "Sending..." : "Send suggestion";
    };

    const validate = () => {
      hideSummary();

      const requiredFieldIds = ["resource-url", "resource-message"];
      for (const id of requiredFieldIds) clearFieldError(id);

      const issues = [];

      const urlEl = form.querySelector("#resource-url");
      const urlValue = urlEl && "value" in urlEl ? String(urlEl.value) : "";
      if (!urlValue.trim()) {
        setFieldError("resource-url", "Please enter a URL.");
        issues.push("Resource link is required");
      }

      const messageEl = form.querySelector("#resource-message");
      const messageValue =
        messageEl && "value" in messageEl ? String(messageEl.value) : "";
      if (!messageValue.trim()) {
        setFieldError("resource-message", "Please tell us why this fits.");
        issues.push("A short explanation is required");
      }

      if (issues.length > 0 && summaryEl && summaryListEl) {
        summaryListEl.innerHTML = issues
          .map((text) => `<li>${text}</li>`)
          .join("");
        summaryEl.hidden = false;
        summaryEl.focus();
        return false;
      }

      return true;
    };

    if (retryBtn) {
      retryBtn.addEventListener("click", () => {
        hideMessages();
        resetTurnstile();
        submitBtn.focus();
      });
    }

    const urlControl = form.querySelector("#resource-url");
    const messageControl = form.querySelector("#resource-message");

    if (urlControl) {
      urlControl.addEventListener("input", () => {
        clearFieldError("resource-url");
        hideSummary();
      });
    }
    if (messageControl) {
      messageControl.addEventListener("input", () => {
        clearFieldError("resource-message");
        hideSummary();
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hideMessages();
      hideSummary();

      const gotcha = gotchaEl && gotchaEl.value ? String(gotchaEl.value) : "";
      if (gotcha.trim().length > 0) {
        showSuccess("Thanks — your suggestion was sent.");
        return;
      }

      if (!validate()) return;

      const formData = new FormData(form);
      const turnstileToken = formData.get("cf-turnstile-response");
      if (
        turnstileWidgetEl &&
        (!turnstileToken || !String(turnstileToken).trim())
      ) {
        showError("Please complete the security check and try again.");
        return;
      }

      setBusy(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          showSuccess("Thanks — your suggestion was sent.");
          resetTurnstile();
          window.setTimeout(() => {
            form.reset();
          }, 2000);
          return;
        }

        resetTurnstile();
        showError("Something went wrong. Please try again later.");
      } catch (_err) {
        resetTurnstile();
        showError(
          "Unable to send. Please check your connection and try again.",
        );
      } finally {
        setBusy(false);
      }
    });
  })();
</script>
