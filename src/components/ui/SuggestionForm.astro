---
import Button from "./Button.astro";
import Field from "./form/Field.astro";
import TextInput from "./form/TextInput.astro";
import Textarea from "./form/Textarea.astro";
import { errorSummaryClass } from "./form/formStyles";
import MessageSquare from "lucide-astro/MessageSquare";

const action = "https://formspree.io/f/xgoobynr";
---

<form
  action={action}
  method="POST"
  novalidate
  class="ui-hover-brighten-body group rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark overflow-hidden"
  data-suggestion-form
>
  <header
    class="flex items-center gap-3 px-5 py-4 border-b border-divider-surface"
  >
    <MessageSquare class="h-6 w-6 text-accent shrink-0" aria-hidden="true" />
    <h2
      class="text-lg font-semibold leading-tight text-text-light dark:text-text-dark transition-colors group-hover:text-accent"
    >
      Have a Suggestion?
    </h2>
  </header>

  <div class="p-5 space-y-4">
    <div class="space-y-4">
      <p
        class="ui-muted-body text-sm leading-relaxed text-text-mutedLight dark:text-text-mutedDark"
      >
        This dashboard is maintained by me and built on top of the Hiring
        Without Whiteboards open-source dataset. I try to keep it in sync with
        upstream, but I also apply local fixes and additions here.
      </p>

      <div class="space-y-2">
        <h3 class="text-sm font-semibold text-text-light dark:text-text-dark">
          What this form is for
        </h3>
        <ul
          class="ui-muted-body list-disc pl-5 space-y-1 text-sm text-text-mutedLight dark:text-text-mutedDark marker:text-accent"
        >
          <li>Report broken links or outdated info</li>
          <li>Suggest new companies</li>
          <li>Share interview experiences or improvements</li>
          <li>
            I read everything and try to respond, but there are no guarantees.
          </li>
        </ul>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm font-semibold text-text-light dark:text-text-dark">
          About the original project
        </h3>
        <p
          class="ui-muted-body text-sm leading-relaxed text-text-mutedLight dark:text-text-mutedDark"
        >
          If you can, please contribute directly to the original repository,
          <a
            href="https://github.com/poteto/hiring-without-whiteboards"
            target="_blank"
            rel="noopener noreferrer"
            class="inline text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
            >(hiring-without-whiteboards)
          </a>
          - that way the whole community benefits.
        </p>
        <p
          class="ui-muted-body text-sm leading-relaxed text-text-mutedLight dark:text-text-mutedDark"
        >
          I built this form because interviewing is hard enough as it is. Not
          everyone wants to open a GitHub issue or write markdown. So this is a
          lower-friction way to help, and I will do my best to carry anything
          submitted here back into the upstream project when it makes sense.
        </p>
      </div>
    </div>

    <hr class="border-divider-surface" />

    <div
      data-validation-summary
      hidden
      role="alert"
      aria-live="polite"
      tabindex="-1"
      class={errorSummaryClass}
    >
      <p class="m-0 font-medium">Please fix the highlighted fields.</p>
      <ul class="mt-2 list-disc pl-5 space-y-1" data-validation-summary-list>
        <!-- populated by client-side validation -->
      </ul>
    </div>

    <!-- Honeypot (spam trap) -->
    <div class="sr-only" aria-hidden="true">
      <label for="suggestion-gotcha">Leave this field empty</label>
      <input
        type="text"
        name="_gotcha"
        id="suggestion-gotcha"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      <Field id="suggestion-name" label="Name">
        <TextInput
          slot="control"
          id="suggestion-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="e.g. Jane Doe"
          describedBy="suggestion-name-error"
        />
      </Field>

      <Field
        id="suggestion-email"
        label="Email"
        hint="Optional, but recommended so I can reply"
      >
        <TextInput
          slot="control"
          id="suggestion-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="e.g. jane@example.com"
          describedBy="suggestion-email-hint suggestion-email-error"
        />
      </Field>

      <Field id="suggestion-company-name" label="Company name">
        <TextInput
          slot="control"
          id="suggestion-company-name"
          name="companyName"
          type="text"
          placeholder="e.g. Acme Corp"
          describedBy="suggestion-company-name-error"
        />
      </Field>

      <Field id="suggestion-company-url" label="Company URL">
        <TextInput
          slot="control"
          id="suggestion-company-url"
          name="companyUrl"
          type="url"
          placeholder="e.g. https://acme.com/careers"
          describedBy="suggestion-company-url-error"
        />
      </Field>

      <Field
        id="suggestion-process"
        label="Process"
        required
        class="md:col-span-2"
      >
        <Textarea
          slot="control"
          id="suggestion-process"
          name="process"
          required
          rows={6}
          placeholder="e.g. 1 phone screen, 1 take-home project, 1 on-site pair programming session"
          describedBy="suggestion-process-error"
          data-required-field
        />
      </Field>
    </div>

    <div
      data-suggestion-success
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-success-border bg-success-bg/10 p-4 text-sm text-success-text"
    >
      Thanks — your message was sent.
    </div>

    <div
      data-suggestion-error
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-warning-border bg-warning-bg/10 p-4 text-sm text-warning-text"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="m-0" data-suggestion-error-text>
          Something went wrong. Please try again later.
        </p>
        <button
          type="button"
          class="underline underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
          data-suggestion-retry
        >
          Try again
        </button>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <Button
        variant="primary"
        tone="solid"
        type="submit"
        data-suggestion-submit
      >
        Send suggestion
      </Button>
    </div>
  </div>
</form>

<form
  action={action}
  method="POST"
  novalidate
  class="ui-hover-brighten-body group mt-6 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark overflow-hidden"
  data-company-confirmation-form
>
  <header
    class="flex items-center gap-3 px-5 py-4 border-b border-divider-surface"
  >
    <MessageSquare class="h-6 w-6 text-accent shrink-0" aria-hidden="true" />
    <h2
      id="company-confirmation-heading"
      class="text-lg font-semibold leading-tight text-text-light dark:text-text-dark transition-colors group-hover:text-accent"
    >
      Company Verification
    </h2>
  </header>

  <div class="p-5 space-y-4">
    <p
      class="ui-muted-body text-sm text-text-mutedLight dark:text-text-mutedDark"
    >
      Are you a hiring manager or recruiter? Confirm your company&apos;s process
      is accurate and get a verified badge.
    </p>

    <div
      data-company-validation-summary
      hidden
      role="alert"
      aria-live="polite"
      tabindex="-1"
      class={errorSummaryClass}
    >
      <p class="m-0 font-medium">Please fix the highlighted fields.</p>
      <ul
        class="mt-2 list-disc pl-5 space-y-1"
        data-company-validation-summary-list
      >
      </ul>
    </div>

    <div class="sr-only" aria-hidden="true">
      <label for="company-confirmation-gotcha">Leave this field empty</label>
      <input
        type="text"
        name="_gotcha"
        id="company-confirmation-gotcha"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      <Field id="verification-company-name" label="Company name" required>
        <TextInput
          slot="control"
          id="verification-company-name"
          name="verificationCompanyName"
          type="text"
          required
          describedBy="verification-company-name-error"
        />
      </Field>

      <Field id="verification-role" label="Your role/title" required>
        <TextInput
          slot="control"
          id="verification-role"
          name="verificationSubmitterRole"
          type="text"
          required
          describedBy="verification-role-error"
        />
      </Field>

      <Field id="verification-email" label="Company email" required>
        <TextInput
          slot="control"
          id="verification-email"
          name="verificationCompanyEmail"
          type="email"
          required
          describedBy="verification-email-error"
        />
      </Field>
    </div>

    <Field
      id="verification-notes"
      label="Anything else you'd like to share? (optional)"
    >
      <Textarea
        slot="control"
        id="verification-notes"
        name="verificationNotes"
        rows={4}
        describedBy="verification-notes-error"
      />
    </Field>

    <div
      data-company-success
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-success-border bg-success-bg/10 p-4 text-sm text-success-text"
    >
      Thanks — your confirmation was sent.
    </div>

    <div
      data-company-error
      hidden
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="rounded-md border border-warning-border bg-warning-bg/10 p-4 text-sm text-warning-text"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="m-0" data-company-error-text>
          Something went wrong. Please try again later.
        </p>
        <button
          type="button"
          class="underline underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
          data-company-retry
        >
          Try again
        </button>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <Button variant="primary" tone="solid" type="submit" data-company-submit>
        Send Verification
      </Button>
    </div>
  </div>
</form>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-suggestion-form]");
    if (!form) return;

    const successEl = form.querySelector("[data-suggestion-success]");
    const errorEl = form.querySelector("[data-suggestion-error]");
    const errorTextEl = form.querySelector("[data-suggestion-error-text]");
    const retryBtn = form.querySelector("[data-suggestion-retry]");
    const submitBtn = form.querySelector("[data-suggestion-submit]");
    const gotchaEl = form.querySelector("#suggestion-gotcha");
    const validationSummaryEl = form.querySelector("[data-validation-summary]");
    const validationSummaryListEl = form.querySelector(
      "[data-validation-summary-list]",
    );

    if (!successEl || !errorEl || !errorTextEl || !submitBtn) return;

    const setBusy = (busy) => {
      submitBtn.disabled = busy;
      submitBtn.setAttribute("aria-busy", busy ? "true" : "false");
      const label = busy ? "Sending..." : "Send suggestion";
      submitBtn.textContent = label;
    };

    const hideValidationSummary = () => {
      if (!validationSummaryEl || !validationSummaryListEl) return;
      validationSummaryEl.hidden = true;
      validationSummaryListEl.innerHTML = "";
    };

    const clearFieldError = (fieldId) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.removeAttribute("aria-invalid");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const setFieldError = (fieldId, message) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.setAttribute("aria-invalid", "true");
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const validateRequiredFields = () => {
      hideValidationSummary();

      const requiredFieldIds = ["suggestion-process"];
      for (const id of requiredFieldIds) clearFieldError(id);

      const issues = [];

      const processEl = form.querySelector("#suggestion-process");
      const processValue =
        processEl && "value" in processEl ? String(processEl.value) : "";
      if (!processValue.trim()) {
        setFieldError(
          "suggestion-process",
          "Please describe the interview process.",
        );
        issues.push("Process is required");
      }

      if (issues.length > 0 && validationSummaryEl && validationSummaryListEl) {
        validationSummaryListEl.innerHTML = issues
          .map((text) => `<li>${text}</li>`)
          .join("");
        validationSummaryEl.hidden = false;
        validationSummaryEl.focus();
        return false;
      }

      return true;
    };

    const hideMessages = () => {
      successEl.hidden = true;
      errorEl.hidden = true;
    };

    const showSuccess = (message) => {
      hideMessages();
      successEl.textContent = message;
      successEl.hidden = false;
      successEl.focus();
    };

    const showError = (message) => {
      hideMessages();
      errorTextEl.textContent = message;
      errorEl.hidden = false;
      errorEl.focus();
    };

    if (retryBtn) {
      retryBtn.addEventListener("click", () => {
        hideMessages();
        submitBtn.focus();
      });
    }

    // Clear inline errors as the user fixes them
    const processControl = form.querySelector("#suggestion-process");
    if (processControl) {
      processControl.addEventListener("input", () => {
        clearFieldError("suggestion-process");
        hideValidationSummary();
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hideMessages();
      hideValidationSummary();

      const gotcha = gotchaEl && gotchaEl.value ? String(gotchaEl.value) : "";
      if (gotcha.trim().length > 0) {
        showSuccess("Thanks — your message was sent.");
        return;
      }

      if (!validateRequiredFields()) {
        return;
      }

      setBusy(true);

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          showSuccess("Thanks — your message was sent.");
          window.setTimeout(() => {
            form.reset();
          }, 2000);
          return;
        }

        showError("Something went wrong. Please try again later.");
      } catch (_err) {
        showError(
          "Unable to send. Please check your connection and try again.",
        );
      } finally {
        setBusy(false);
      }
    });
  })();

  (() => {
    const form = document.querySelector("[data-company-confirmation-form]");
    if (!form) return;

    const successEl = form.querySelector("[data-company-success]");
    const errorEl = form.querySelector("[data-company-error]");
    const errorTextEl = form.querySelector("[data-company-error-text]");
    const retryBtn = form.querySelector("[data-company-retry]");
    const submitBtn = form.querySelector("[data-company-submit]");
    const gotchaEl = form.querySelector("#company-confirmation-gotcha");
    const summaryEl = form.querySelector("[data-company-validation-summary]");
    const summaryListEl = form.querySelector(
      "[data-company-validation-summary-list]",
    );

    if (!successEl || !errorEl || !errorTextEl || !submitBtn) return;

    const clearFieldError = (fieldId) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.removeAttribute("aria-invalid");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    const setFieldError = (fieldId, message) => {
      const control = form.querySelector(`#${CSS.escape(fieldId)}`);
      const error = form.querySelector(`#${CSS.escape(fieldId)}-error`);
      if (control) control.setAttribute("aria-invalid", "true");
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const hideSummary = () => {
      if (!summaryEl || !summaryListEl) return;
      summaryEl.hidden = true;
      summaryListEl.innerHTML = "";
    };

    const hideMessages = () => {
      successEl.hidden = true;
      errorEl.hidden = true;
    };

    const showSuccess = (message) => {
      hideMessages();
      successEl.textContent = message;
      successEl.hidden = false;
      successEl.focus();
    };

    const showError = (message) => {
      hideMessages();
      errorTextEl.textContent = message;
      errorEl.hidden = false;
      errorEl.focus();
    };

    const setBusy = (busy) => {
      submitBtn.disabled = busy;
      submitBtn.setAttribute("aria-busy", busy ? "true" : "false");
      submitBtn.textContent = busy ? "Sending..." : "Send Verification";
    };

    const validate = () => {
      hideSummary();

      const requiredFieldIds = [
        "verification-company-name",
        "verification-role",
        "verification-email",
      ];
      for (const id of requiredFieldIds) clearFieldError(id);

      const issues = [];

      for (const id of requiredFieldIds) {
        const control = form.querySelector(`#${CSS.escape(id)}`);
        const value =
          control && "value" in control ? String(control.value) : "";
        if (!value.trim()) {
          setFieldError(id, "This field is required.");
          issues.push(`${id.replace("verification-", "")} is required`);
        }
      }

      if (issues.length > 0 && summaryEl && summaryListEl) {
        summaryListEl.innerHTML = issues
          .map((issue) => `<li>${issue}</li>`)
          .join("");
        summaryEl.hidden = false;
        summaryEl.focus();
        return false;
      }

      return true;
    };

    if (retryBtn) {
      retryBtn.addEventListener("click", () => {
        hideMessages();
        submitBtn.focus();
      });
    }

    form.addEventListener("input", () => {
      hideSummary();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hideMessages();
      hideSummary();

      const gotcha = gotchaEl && gotchaEl.value ? String(gotchaEl.value) : "";
      if (gotcha.trim().length > 0) {
        showSuccess("Thanks — your confirmation was sent.");
        return;
      }

      if (!validate()) return;

      setBusy(true);

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          showSuccess("Thanks — your confirmation was sent.");
          window.setTimeout(() => {
            form.reset();
          }, 2000);
          return;
        }

        showError("Something went wrong. Please try again later.");
      } catch (_err) {
        showError(
          "Unable to send. Please check your connection and try again.",
        );
      } finally {
        setBusy(false);
      }
    });
  })();
</script>
