---
export type CurationStatus = "new" | "edited" | "live";

interface Props {
  status: CurationStatus;
  class?: string;
}

const { status, class: className } = Astro.props as Props;

const bgVar =
  status === "new"
    ? "--curation-new"
    : status === "live"
      ? "--curation-live"
      : "--curation-updated";

const classes = `inline-block h-2 w-2 rounded-full ring-1 ring-black/10 dark:ring-white/20 ${className ?? ""}`;
---

<span
  class={classes}
  style={`background-color: var(${bgVar});`}
  aria-hidden="true"></span>
