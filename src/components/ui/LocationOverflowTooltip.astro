---
import { createUniqueId } from "../../utils/company";

interface Props {
  remainingLocations: string[];
  count: number;
}

const { remainingLocations, count } = Astro.props;

const tooltipId = createUniqueId("locations-tooltip");
---

<button
  class="location-chip location-chip--button group/loc relative hover:border-accent/30 focus:outline-none focus:ring-2 focus:ring-accent"
  aria-label={`Show ${count} more location${count === 1 ? "" : "s"}`}
  aria-describedby={tooltipId}
  type="button"
>
  +{count}
  <div
    id={tooltipId}
    class="absolute top-0 left-full ml-2 hidden group-hover/loc:block group-focus/loc:block group-focus-within/loc:block pointer-events-none border border-border-light dark:border-border-dark rounded-lg p-3 text-xs text-text-light dark:text-text-dark bg-surface-light dark:bg-surface-dark shadow-lg ring-1 ring-black/5 dark:ring-white/10 w-fit max-w-[min(28rem,calc(100vw-2rem))] wrap-break-word z-50 text-left"
    role="tooltip"
  >
    <div class="flex flex-col space-y-1">
      {remainingLocations.map((loc) => <span>{loc}</span>)}
    </div>
  </div>
</button>
