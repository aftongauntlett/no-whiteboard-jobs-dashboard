---
import {
  COMPANY_CARD_EXTERNAL_ICON_CLASS,
  COMPANY_CARD_HEADER_CLASS,
  COMPANY_CARD_INTERACTIVE_CLASS,
  COMPANY_CARD_LINK_CLASS,
  COMPANY_CARD_NAME_HOVER_CLASS,
  COMPANY_CARD_STATIC_CLASS,
  COMPANY_CARD_TITLE_CLASS,
  COMPANY_CARD_TITLE_INLINE_CLASS,
  COMPANY_INTERVIEW_TEXT_CLASS_CARD,
  COMPANY_INTERVIEW_TEXT_CLASS_LIST,
  COMPANY_INTERVIEW_TOGGLE_CLASS,
  COMPANY_LIST_ACTION_LINK_CLASS,
  COMPANY_LIST_ACTION_WRAPPER_CLASS,
  COMPANY_LIST_COL_B_CLASS,
  COMPANY_LIST_COL_C_CLASS,
  COMPANY_LIST_GRID_CLASS,
  COMPANY_LIST_ITEM_CLASS,
  COMPANY_LIST_LINK_CLASS,
  COMPANY_LIST_NAME_CLASS,
  COMPANY_LIST_TITLE_CLASS,
} from "../companyStyles";
---

<template data-companies-template="card-interactive">
  <article class={COMPANY_CARD_INTERACTIVE_CLASS}>
    <a
      data-company-link
      target="_blank"
      rel="noopener noreferrer"
      class={COMPANY_CARD_LINK_CLASS}></a>

    <div class="relative flex flex-col">
      <header class={COMPANY_CARD_HEADER_CLASS}>
        <div class="min-w-0 flex items-center gap-2">
          <h3 class={COMPANY_CARD_TITLE_CLASS}>
            <span
              class={"inline-flex items-center gap-2 " +
                COMPANY_CARD_TITLE_INLINE_CLASS}
            >
              <span data-company-name class={COMPANY_CARD_NAME_HOVER_CLASS}
              ></span>
              <span
                data-company-source
                class="hidden curation-dot"
                aria-hidden="true"></span>
              <span data-company-source-sr class="hidden sr-only"></span>
            </span>
          </h3>
          <span data-company-employment class="ui-badge"></span>
        </div>

        <span
          data-company-external-icon
          class={COMPANY_CARD_EXTERNAL_ICON_CLASS}
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M14 3h7v7"></path>
            <path d="M10 14L21 3"></path>
            <path d="M21 14v7h-7"></path>
            <path d="M3 10v11h11"></path>
          </svg>
        </span>
      </header>

      <div data-company-interview class="relative z-30 mt-2">
        <div
          data-company-interview-text
          data-readmore-text
          data-readmore-clamp="line-clamp-3"
          class={COMPANY_INTERVIEW_TEXT_CLASS_CARD +
            " line-clamp-3 interview-markdown"}
        >
          <div data-company-interview-html></div>
        </div>
        <div
          data-company-locations
          class="mt-2 flex flex-wrap gap-2"
          aria-label="Company locations"
        >
        </div>
        <div class="text-right">
          <button
            type="button"
            data-company-interview-toggle
            data-readmore-toggle
            class={COMPANY_INTERVIEW_TOGGLE_CLASS}
            aria-expanded="false"
          >
            Read more
          </button>
        </div>
      </div>
    </div>
  </article>
</template>

<template data-companies-template="card-static">
  <article class={COMPANY_CARD_STATIC_CLASS}>
    <header class={COMPANY_CARD_HEADER_CLASS}>
      <div class="min-w-0 flex items-center gap-2">
        <h3 class={COMPANY_CARD_TITLE_CLASS}>
          <span
            class={"inline-flex items-center gap-2 " +
              COMPANY_CARD_TITLE_INLINE_CLASS}
          >
            <span data-company-name></span>
            <span
              data-company-source
              class="hidden curation-dot"
              aria-hidden="true"></span>
            <span data-company-source-sr class="hidden sr-only"></span>
          </span>
        </h3>
        <span data-company-employment class="ui-badge"></span>
      </div>
    </header>

    <div data-company-interview class="relative z-30 mt-2">
      <div
        data-company-interview-text
        data-readmore-text
        data-readmore-clamp="line-clamp-3"
        class={COMPANY_INTERVIEW_TEXT_CLASS_CARD +
          " line-clamp-3 interview-markdown"}
      >
        <div data-company-interview-html></div>
      </div>
      <div
        data-company-locations
        class="mt-2 flex flex-wrap gap-2"
        aria-label="Company locations"
      >
      </div>
      <div class="text-right">
        <button
          type="button"
          data-company-interview-toggle
          data-readmore-toggle
          class={COMPANY_INTERVIEW_TOGGLE_CLASS}
          aria-expanded="false"
        >
          Read more
        </button>
      </div>
    </div>
  </article>
</template>

<template data-companies-template="list-interactive">
  <li class={COMPANY_LIST_ITEM_CLASS}>
    <a
      data-company-link
      target="_blank"
      rel="noopener noreferrer"
      class={COMPANY_LIST_LINK_CLASS}></a>

    <div class={COMPANY_LIST_GRID_CLASS}>
      <div class="min-w-0">
        <h3 class={COMPANY_LIST_TITLE_CLASS}>
          <span class="flex items-center gap-2 min-w-0">
            <span data-company-name class={COMPANY_LIST_NAME_CLASS}></span>
            <span
              data-company-source
              class="hidden curation-dot"
              aria-hidden="true"></span>
            <span data-company-source-sr class="hidden sr-only"></span>
          </span>
        </h3>
      </div>

      <div class={COMPANY_LIST_COL_B_CLASS}>
        <div class="flex items-start">
          <span data-company-employment class="ui-badge"></span>
        </div>
      </div>

      <div class={COMPANY_LIST_COL_C_CLASS}>
        <div data-company-interview class="relative z-30">
          <div
            data-company-interview-text
            data-readmore-text
            data-readmore-clamp="line-clamp-2"
            class={COMPANY_INTERVIEW_TEXT_CLASS_LIST +
              " line-clamp-2 interview-markdown"}
          >
            <div data-company-interview-html></div>
          </div>
          <div
            data-company-locations
            class="mt-1.5 flex flex-wrap items-center gap-2"
            aria-label="Company locations"
          >
          </div>
          <div class="text-right">
            <button
              type="button"
              data-company-interview-toggle
              data-readmore-toggle
              class={COMPANY_INTERVIEW_TOGGLE_CLASS}
              aria-expanded="false"
            >
              Read more
            </button>
          </div>
        </div>

        <div data-company-no-interview class="relative z-30">
          <p
            class="ui-muted-body text-xs text-text-mutedLight dark:text-text-mutedDark transition-colors"
          >
            No details provided.
          </p>
          <div
            data-company-locations
            class="mt-1.5 flex flex-wrap items-center gap-2"
            aria-label="Company locations"
          >
          </div>
        </div>
      </div>

      <div class={COMPANY_LIST_ACTION_WRAPPER_CLASS}>
        <a
          data-company-action-link
          target="_blank"
          rel="noopener noreferrer"
          class={COMPANY_LIST_ACTION_LINK_CLASS}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M14 3h7v7"></path>
            <path d="M10 14L21 3"></path>
            <path d="M21 14v7h-7"></path>
            <path d="M3 10v11h11"></path>
          </svg>
        </a>
      </div>
    </div>
  </li>
</template>

<template data-companies-template="list-static">
  <li class={COMPANY_LIST_ITEM_CLASS}>
    <div class={COMPANY_LIST_GRID_CLASS}>
      <div class="min-w-0">
        <h3 class={COMPANY_LIST_TITLE_CLASS}>
          <span class="flex items-center gap-2 min-w-0">
            <span data-company-name class={COMPANY_LIST_NAME_CLASS}></span>
            <span
              data-company-source
              class="hidden curation-dot"
              aria-hidden="true"></span>
            <span data-company-source-sr class="hidden sr-only"></span>
          </span>
        </h3>
      </div>

      <div class={COMPANY_LIST_COL_B_CLASS}>
        <div class="flex items-start">
          <span data-company-employment class="ui-badge"></span>
        </div>
      </div>

      <div class={COMPANY_LIST_COL_C_CLASS}>
        <div data-company-interview class="relative z-30">
          <div
            data-company-interview-text
            data-readmore-text
            data-readmore-clamp="line-clamp-2"
            class={COMPANY_INTERVIEW_TEXT_CLASS_LIST +
              " line-clamp-2 interview-markdown"}
          >
            <div data-company-interview-html></div>
          </div>
          <div
            data-company-locations
            class="mt-1.5 flex flex-wrap items-center gap-2"
            aria-label="Company locations"
          >
          </div>
          <div class="text-right">
            <button
              type="button"
              data-company-interview-toggle
              data-readmore-toggle
              class={COMPANY_INTERVIEW_TOGGLE_CLASS}
              aria-expanded="false"
            >
              Read more
            </button>
          </div>
        </div>

        <div data-company-no-interview class="relative z-30">
          <p
            class="ui-muted-body text-xs text-text-mutedLight dark:text-text-mutedDark transition-colors"
          >
            No details provided.
          </p>
          <div
            data-company-locations
            class="mt-1.5 flex flex-wrap items-center gap-2"
            aria-label="Company locations"
          >
          </div>
        </div>
      </div>
    </div>
  </li>
</template>

<template data-companies-template="location-chip">
  <span class="location-chip"></span>
</template>

<template data-companies-template="location-overflow">
  <button
    type="button"
    class="location-chip location-chip--button group/loc relative hover:border-accent/30 focus:outline-none focus:ring-2 focus:ring-accent"
  >
    <span data-location-overflow-count></span>
    <div
      class="absolute top-0 left-full ml-2 invisible group-hover/loc:visible group-focus/loc:visible group-focus-within/loc:visible pointer-events-none border border-border-light dark:border-border-dark rounded-lg p-3 text-xs text-text-light dark:text-text-dark bg-surface-light dark:bg-surface-dark shadow-lg ring-1 ring-black/5 dark:ring-white/10 w-fit max-w-[min(28rem,calc(100vw-2rem))] break-words z-50 text-left"
      role="tooltip"
      data-location-overflow-tooltip
    >
      <div class="flex flex-col space-y-1" data-location-overflow-items></div>
    </div>
  </button>
</template>

<template data-companies-template="pagination-nav">
  <nav
    aria-label="Pagination"
    class="mt-6 rounded-lg border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-3 flex items-center justify-center gap-2"
  >
    <button type="button" data-pagination-prev class="pagination-button">
      ← Previous
    </button>

    <div class="flex items-center gap-1" data-pagination-pages></div>

    <button type="button" data-pagination-next class="pagination-button">
      Next →
    </button>
  </nav>
</template>

<template data-companies-template="pagination-page">
  <button type="button" class="pagination-button"></button>
</template>

<template data-companies-template="pagination-current">
  <span aria-current="page" class="pagination-current"></span>
</template>

<template data-companies-template="pagination-ellipsis">
  <span class="pagination-ellipsis" aria-hidden="true">…</span>
</template>
