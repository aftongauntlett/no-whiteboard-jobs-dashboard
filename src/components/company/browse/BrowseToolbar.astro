---
import Button from "../../ui/Button.astro";

import type { HTMLAttributes } from "astro/types";

type DivAttrs = HTMLAttributes<"div">;
type InputAttrs = HTMLAttributes<"input">;
type ButtonAttrs = HTMLAttributes<"button">;

export interface Props {
  searchInputProps?: InputAttrs;
  menuButtonProps?: ButtonAttrs;
}

const { searchInputProps = {}, menuButtonProps = {} } = Astro.props;
---

<div class="flex flex-1 min-w-0 items-center gap-2 md:gap-0">
  <div class="relative flex-1 min-w-0 md:max-w-[min(28rem,60vw)]">
    <label class="sr-only" for="company-search">Search companies</label>
    <span
      class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-text-mutedLight dark:text-text-mutedDark"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </span>
    <input
      id="company-search"
      type="search"
      placeholder="Search companies…"
      class="w-full rounded-full md:rounded-r-none border border-border-light dark:border-border-dark bg-surface-light/70 dark:bg-surface-dark/60 py-2.5 pl-10 pr-4 text-sm text-text-light dark:text-text-dark shadow-sm placeholder:text-text-mutedLight/80 dark:placeholder:text-text-mutedDark/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      {...searchInputProps}
    />
  </div>

  <div class="md:-ml-px shrink-0">
    <Button
      type="button"
      variant="secondary"
      tone="soft"
      shape="pill"
      class="cursor-pointer inline-flex w-auto shrink-0 items-center justify-center gap-0 md:gap-3 md:rounded-l-none p-2.5 md:px-4 md:py-2.5"
      {...menuButtonProps}
    >
      <span
        class="shrink-0 text-text-mutedLight dark:text-text-mutedDark"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="M21 4H14"></path>
          <path d="M10 4H3"></path>
          <path d="M21 12H12"></path>
          <path d="M8 12H3"></path>
          <path d="M21 20H16"></path>
          <path d="M12 20H3"></path>
          <path d="M14 2v4"></path>
          <path d="M8 10v4"></path>
          <path d="M16 18v4"></path>
        </svg>
      </span>

      <span
        class="hidden md:inline text-left text-text-mutedLight dark:text-text-mutedDark"
      >
        Filter &amp; sort
      </span>
    </Button>
  </div>
</div>
