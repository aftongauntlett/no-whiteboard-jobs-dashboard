---
import type { HTMLAttributes } from "astro/types";

type DivAttrs = HTMLAttributes<"div">;
type ButtonAttrs = HTMLAttributes<"button">;

export interface Props {
  wrapperProps?: DivAttrs;
  cardButtonProps?: ButtonAttrs;
  listButtonProps?: ButtonAttrs;
}

const {
  wrapperProps = {},
  cardButtonProps = {},
  listButtonProps = {},
} = Astro.props;
---

<div
  class="companies-view-toggle hidden md:inline-grid items-center shrink-0 md:ml-auto"
  role="radiogroup"
  aria-label="Company view"
  data-companies-view-toggle
  data-view="card"
  {...wrapperProps}
>
  <button
    type="button"
    class="companies-view-toggle-button"
    {...cardButtonProps}
  >
    Cards
  </button>
  <button
    type="button"
    class="companies-view-toggle-button"
    {...listButtonProps}
  >
    List
  </button>
</div>
