---
import Button from "../../ui/Button.astro";

type Attrs = Record<string, any>;

export interface Props {
  wrapperProps?: Attrs;
  cardButtonProps?: Attrs;
  listButtonProps?: Attrs;
}

const {
  wrapperProps = {},
  cardButtonProps = {},
  listButtonProps = {},
} = Astro.props;
---

<div
  class="hidden md:inline-flex items-center shrink-0 rounded-lg border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-1 md:ml-auto"
  role="radiogroup"
  aria-label="Company view"
  {...wrapperProps}
>
  <Button
    type="button"
    variant="secondary"
    style="ghost"
    class="cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium"
    {...cardButtonProps}
  >
    Cards
  </Button>
  <Button
    type="button"
    variant="secondary"
    style="ghost"
    class="cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium"
    {...listButtonProps}
  >
    List
  </Button>
</div>
