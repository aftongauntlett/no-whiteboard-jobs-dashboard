---
export interface Props {
  startIndex: number;
  endIndex: number;
  totalItems: number;
  countProps?: Record<string, any>;
}

const {
  startIndex,
  endIndex,
  totalItems,
  countProps = {},
} = Astro.props as Props;
---

<div class="flex items-center justify-between gap-3">
  <p
    class="text-sm text-text-mutedLight dark:text-text-mutedDark"
    data-companies-count
    {...countProps}
  >
    Showing {startIndex}–{endIndex} of {totalItems} companies
  </p>

  <div class="hidden md:flex items-center gap-2">
    <span
      class="hidden md:inline text-xs text-text-mutedLight dark:text-text-mutedDark"
    >
      Per page
    </span>
    <div class="inline-flex items-center">
      <div
        data-companies-per-page-group="card"
        class="rounded-lg border border-border-light dark:border-border-dark bg-surface-muted p-1"
        role="radiogroup"
        aria-label="Companies per page (grid)"
      >
        <button
          type="button"
          data-companies-per-page-option="12"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          12
        </button>
        <button
          type="button"
          data-companies-per-page-option="24"
          role="radio"
          aria-checked="true"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          24
        </button>
        <button
          type="button"
          data-companies-per-page-option="48"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          48
        </button>
        <button
          type="button"
          data-companies-per-page-option="96"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          96
        </button>
      </div>

      <div
        data-companies-per-page-group="list"
        class="hidden rounded-lg border border-border-light dark:border-border-dark bg-surface-muted p-1"
        role="radiogroup"
        aria-label="Companies per page (list)"
      >
        <button
          type="button"
          data-companies-per-page-option="10"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          10
        </button>
        <button
          type="button"
          data-companies-per-page-option="25"
          role="radio"
          aria-checked="true"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          25
        </button>
        <button
          type="button"
          data-companies-per-page-option="50"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          50
        </button>
        <button
          type="button"
          data-companies-per-page-option="100"
          role="radio"
          aria-checked="false"
          class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          100
        </button>
      </div>
    </div>
  </div>
</div>
