---
import type { Company } from "@data/types";
import CompanyCard from "../CompanyCard.astro";
import CompanyListItem from "../CompanyListItem.astro";

export interface Props {
  paginatedItems: Company[];
}

const { paginatedItems } = Astro.props as Props;
---

<div
  data-companies-view-panel="card"
  class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
>
  {paginatedItems.map((company) => <CompanyCard company={company} />)}
</div>

<div data-companies-view-panel="list" class="hidden mt-4">
  <ul
    class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark divide-y divide-divider-surface md:grid md:gap-x-4 md:items-start md:grid-cols-[fit-content(18rem)_fit-content(20ch)_minmax(0,1fr)_3rem]"
    aria-label="Companies"
  >
    {paginatedItems.map((company) => <CompanyListItem company={company} />)}
  </ul>
</div>
