---
import type { Company } from "@data/types";
import EmploymentBadge from "../ui/EmploymentBadge.astro";
import CurationIndicator from "../ui/CurationIndicator.astro";
import CompanyInterviewPreview from "./CompanyInterviewPreview.astro";
import { createInterviewId } from "../../utils/company";
import {
  COMPANY_LIST_ACTION_LINK_CLASS,
  COMPANY_LIST_ACTION_WRAPPER_CLASS,
  COMPANY_LIST_COL_B_CLASS,
  COMPANY_LIST_COL_C_CLASS,
  COMPANY_LIST_GRID_CLASS,
  COMPANY_LIST_ITEM_CLASS,
  COMPANY_LIST_LINK_CLASS,
  COMPANY_LIST_NAME_CLASS,
  COMPANY_LIST_TITLE_CLASS,
} from "./companyStyles";

type Props = {
  company: Company;
};

const { company } = Astro.props as Props;
const maxVisibleLocations = 1;

const interviewId = createInterviewId(company);
---

<li
  class={COMPANY_LIST_ITEM_CLASS}
>
  {
    company.careersUrl ? (
      <>
        <a
          href={company.careersUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={COMPANY_LIST_LINK_CLASS}
          aria-label={`Open ${company.name} careers page in a new tab`}
        ></a>
        <div class={COMPANY_LIST_GRID_CLASS}>
          <!-- Column A: Company -->
          <div class="min-w-0">
            <h3 class={COMPANY_LIST_TITLE_CLASS}>
              <span class="flex items-center gap-2 min-w-0">
                <span class={COMPANY_LIST_NAME_CLASS}>
                  {company.name}
                </span>
                {
                  company.source === "local" ? (
                    <CurationIndicator status={company.curationStatus ?? "edited"} />
                  ) : null
                }
              </span>
            </h3>
          </div>

          <!-- Column B: Employment + locations -->
          <div class={COMPANY_LIST_COL_B_CLASS}>
            <div class="flex items-start">
              <EmploymentBadge employmentType={company.employmentType} />
            </div>
          </div>

          <!-- Column C: Interview -->
          <div class={COMPANY_LIST_COL_C_CLASS}>
            <CompanyInterviewPreview
              interviewProcessHtml={company.interviewProcessHtml}
              interviewId={interviewId}
              variant="list"
              locations={company.locations}
              maxVisibleLocations={maxVisibleLocations}
            />
          </div>

          <!-- Far right action -->
          <div class={COMPANY_LIST_ACTION_WRAPPER_CLASS}>
            <a
              href={company.careersUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={COMPANY_LIST_ACTION_LINK_CLASS}
              aria-label={`Open ${company.name} careers page in a new tab`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="M14 3h7v7" />
                <path d="M10 14L21 3" />
                <path d="M21 14v7h-7" />
                <path d="M3 10v11h11" />
              </svg>
            </a>
          </div>
        </div>
      </>
    ) : (
      <div class={COMPANY_LIST_GRID_CLASS}>
        <!-- Column A: Company -->
        <div class="min-w-0">
          <h3 class={COMPANY_LIST_TITLE_CLASS}>
            <span class="flex items-center gap-2 min-w-0">
              <span class={COMPANY_LIST_NAME_CLASS}>
                {company.name}
              </span>
              {
                company.source === "local" ? (
                  <CurationIndicator status={company.curationStatus ?? "edited"} />
                ) : null
              }
            </span>
          </h3>
        </div>

        <!-- Column B: Employment + locations -->
        <div class={COMPANY_LIST_COL_B_CLASS}>
          <div class="flex items-start">
            <EmploymentBadge employmentType={company.employmentType} />
          </div>
        </div>

        <!-- Column C: Interview -->
        <div class={COMPANY_LIST_COL_C_CLASS}>
          <CompanyInterviewPreview
            interviewProcessHtml={company.interviewProcessHtml}
            interviewId={interviewId}
            variant="list"
            locations={company.locations}
            maxVisibleLocations={maxVisibleLocations}
          />
        </div>

      </div>
    )
  }
</li>
