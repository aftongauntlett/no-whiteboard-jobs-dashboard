---
import BrowseToolbar from "./browse/BrowseToolbar.astro";
import BrowseViewToggle from "./browse/BrowseViewToggle.astro";
import BrowsePerPageControls from "./browse/BrowsePerPageControls.astro";
import BrowseResultsPanels from "./browse/BrowseResultsPanels.astro";
import BrowsePaginationControls from "./browse/BrowsePaginationControls.astro";
import BrowseTemplates from "./browse/BrowseTemplates.astro";
import type { Company } from "@data/types";

export interface Props {
  paginatedItems: Company[];
  totalPages: number;
  currentPage: number;
  totalItems: number;
  startIndex: number;
  endIndex: number;
}

const {
  paginatedItems,
  totalPages,
  currentPage,
  totalItems,
  startIndex,
  endIndex,
} = Astro.props as Props;

const toolbarProps = {
  searchInputProps: {
    "data-companies-search": true,
  },
  menuButtonProps: {
    "data-companies-menu-button": true,
    "aria-label": "Filter & Sort",
    "aria-expanded": false,
    "aria-controls": "companies-menu-panel",
  },
};

const viewToggleProps = {
  cardButtonProps: {
    "data-companies-view-button": "card",
    role: "radio" as const,
    "aria-checked": true,
  },
  listButtonProps: {
    "data-companies-view-button": "list",
    role: "radio" as const,
    "aria-checked": false,
  },
};
---

<section
  id="companies"
  class="space-y-4"
  aria-live="polite"
  data-companies-view="card"
  data-companies-section
>
  <h2 class="sr-only">Companies</h2>
  <div data-companies-menu>
    <div
      class="hidden fixed inset-0 bg-black/10 dark:bg-black/30 md:hidden z-50"
      aria-hidden="true"
      data-companies-menu-scrim
    >
    </div>

    <div data-companies-background>
      <div class="flex flex-nowrap items-center gap-3 min-w-0">
        <BrowseToolbar {...toolbarProps} />
        <BrowseViewToggle {...viewToggleProps} />
      </div>

      <div data-companies-browse-content class="mt-4">
        <BrowsePerPageControls
          startIndex={startIndex}
          endIndex={endIndex}
          totalItems={totalItems}
        />

        <BrowseResultsPanels paginatedItems={paginatedItems} />

        <BrowsePaginationControls
          currentPage={currentPage}
          totalPages={totalPages}
        />

        <BrowseTemplates />
      </div>
    </div>

    <div
      class="hidden fixed left-0 right-0 bottom-0 md:left-auto md:right-auto md:bottom-auto w-full md:w-120 md:max-w-[92vw] max-h-[80vh] overflow-y-auto overscroll-contain rounded-t-xl rounded-b-none md:rounded-xl border border-border-light dark:border-border-dark bg-surface-light/95 dark:bg-surface-dark/95 shadow-lg ring-1 ring-black/5 dark:ring-white/10 z-60 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      role="region"
      aria-label="Filter and sort companies"
      tabindex="-1"
      id="companies-menu-panel"
      data-companies-menu-panel
    >
      <div class="p-3 space-y-3 md:space-y-0 md:grid md:grid-cols-2 md:gap-4">
        <div class="pt-1">
          <div
            class="text-sm font-semibold text-text-light dark:text-text-dark mb-2"
          >
            Sort
          </div>
          <div class="grid gap-1" role="radiogroup" aria-label="Sort">
            <button
              type="button"
              data-companies-sort-option="curated-desc"
              role="radio"
              aria-checked="false"
              class="cursor-pointer grid grid-cols-[1fr_auto] items-center gap-2 rounded-md px-2.5 py-2 min-h-11 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span class="min-w-0 text-left">New/Updated first</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden shrink-0 self-center">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-sort-option="name-asc"
              role="radio"
              aria-checked="true"
              class="cursor-pointer grid grid-cols-[1fr_auto] items-center gap-2 rounded-md px-2.5 py-2 min-h-11 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span class="min-w-0 text-left">Company name (A–Z)</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden shrink-0 self-center">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-sort-option="name-desc"
              role="radio"
              aria-checked="false"
              class="cursor-pointer grid grid-cols-[1fr_auto] items-center gap-2 rounded-md px-2.5 py-2 min-h-11 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span class="min-w-0 text-left">Company name (Z–A)</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden shrink-0 self-center">✓</span
              >
            </button>
          </div>
        </div>

        <div class="border-t border-divider-surface pt-3 md:pt-0 md:border-t-0">
          <div
            class="text-sm font-semibold text-text-light dark:text-text-dark mb-2"
          >
            Employment type
          </div>
          <div class="grid gap-1" role="group" aria-label="Employment type">
            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="Remote"
                data-companies-employment-option
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Remote
                <span class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-employment-count="Remote"></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="In-office"
                data-companies-employment-option
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                In-office
                <span class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-employment-count="In-office"></span>)</span
                >
              </span>
            </label>
          </div>
        </div>

        <div class="border-t border-divider-surface pt-3 md:col-span-2">
          <div
            class="text-sm font-semibold text-text-light dark:text-text-dark mb-2"
          >
            Interview style
          </div>

          <!--
            Counts are heuristic and computed client-side from the full dataset
            (before any active filters).
          -->
          <div
            class="grid gap-1 md:grid-cols-2 md:gap-x-3 md:gap-y-1"
            role="group"
            aria-label="Interview style"
          >
            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="take-home"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Take-home
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="take-home"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="live-coding"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Live coding
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="live-coding"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="pair-programming"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Pair programming
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="pair-programming"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="system-design"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                System design
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="system-design"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="behavioral"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Behavioral
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="behavioral"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="portfolio-review"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Portfolio review
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="portfolio-review"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="technical-discussion"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Technical discussion
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="technical-discussion"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="async"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Async
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="async"></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="time-boxed"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Time-boxed
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="time-boxed"
                  ></span>)</span
                >
              </span>
            </label>

            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                value="on-site"
                data-companies-interview-tag
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                On-site
                <span
                  class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-interview-count="on-site"
                  ></span>)</span
                >
              </span>
            </label>
          </div>
        </div>

        <div class="border-t border-divider-surface pt-3 md:col-span-2">
          <div
            class="text-sm font-semibold text-text-light dark:text-text-dark mb-1"
          >
            AI-friendly
          </div>
          <p class="text-xs text-text-mutedLight dark:text-text-mutedDark mb-2">
            Companies that mention AI tools in their process, or are pulled from
            AI-focused job listings.
          </p>
          <div class="grid gap-1" role="group" aria-label="AI-friendly">
            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                data-companies-ai-friendly
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                AI-friendly
                <span class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-ai-friendly-count></span>)</span
                >
              </span>
            </label>
          </div>
        </div>

        <div class="border-t border-divider-surface pt-3 md:col-span-2">
          <div
            class="text-sm font-semibold text-text-light dark:text-text-dark mb-1"
          >
            Has interview details
          </div>
          <p class="text-xs text-text-mutedLight dark:text-text-mutedDark mb-2">
            Only show companies with a documented interview process.
          </p>
          <div
            class="grid gap-1"
            role="group"
            aria-label="Has interview details"
          >
            <label
              class="cursor-pointer grid grid-cols-[auto_1fr] items-center gap-2 rounded-md px-2.5 py-1.5 text-sm hover:bg-surface-hover focus-within:outline-none focus-within:ring-2 focus-within:ring-accent"
            >
              <input
                type="checkbox"
                data-companies-has-interview-details
                class="h-4 w-4 accent-accent"
              />
              <span class="min-w-0 text-left">
                Has interview details
                <span class="ml-1 whitespace-nowrap text-xs tabular-nums text-text-mutedLight dark:text-text-mutedDark"
                  >(<span data-companies-has-interview-count></span>)</span
                >
              </span>
            </label>
          </div>
        </div>

        <div
          class="border-t border-divider-surface pt-3 flex items-center justify-end md:col-span-2"
        >
          <button
            type="button"
            class="cursor-pointer text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
            data-companies-reset
          >
            Reset
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../../scripts/companiesViewToggle.ts"></script>
<script src="../../scripts/companiesBrowseClient.ts"></script>
