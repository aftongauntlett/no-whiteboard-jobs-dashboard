---
import CompanyCard from "./CompanyCard.astro";
import CompanyListItem from "./CompanyListItem.astro";
import Pagination from "../ui/Pagination.astro";
import type { Company } from "@data/types";

export interface Props {
  paginatedItems: Company[];
  totalPages: number;
  currentPage: number;
  totalItems: number;
  startIndex: number;
  endIndex: number;
  companiesViewToggleUrl: string;
  companiesBrowseClientUrl: string;
}

const {
  paginatedItems,
  totalPages,
  currentPage,
  totalItems,
  startIndex,
  endIndex,
  companiesViewToggleUrl,
  companiesBrowseClientUrl,
} = Astro.props as Props;
---

<section
  id="companies"
  class="space-y-6"
  aria-live="polite"
  data-companies-view="card"
>
  <div
    data-companies-menu-scrim
    class="hidden fixed inset-0 bg-black/20 dark:bg-black/50 backdrop-blur-[1px] z-30"
    aria-hidden="true"
  >
  </div>
  <div
    class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="relative z-40" data-companies-menu>
      <button
        type="button"
        data-companies-menu-button
        aria-expanded="false"
        aria-controls="companies-menu-panel"
        class="cursor-pointer inline-flex w-full sm:w-[min(28rem,60vw)] items-center gap-3 rounded-full border border-border-light dark:border-border-dark bg-surface-light/70 dark:bg-surface-dark/60 px-4 py-2.5 text-sm text-text-light dark:text-text-dark shadow-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <span
          class="shrink-0 text-text-mutedLight dark:text-text-mutedDark"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M21 4H14"></path>
            <path d="M10 4H3"></path>
            <path d="M21 12H12"></path>
            <path d="M8 12H3"></path>
            <path d="M21 20H16"></path>
            <path d="M12 20H3"></path>
            <path d="M14 2v4"></path>
            <path d="M8 10v4"></path>
            <path d="M16 18v4"></path>
          </svg>
        </span>
        <span
          class="min-w-0 flex-1 text-left text-text-mutedLight dark:text-text-mutedDark"
        >
          Search, sort, and filter…
        </span>
        <span
          class="shrink-0 text-text-mutedLight dark:text-text-mutedDark"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </span>
      </button>

      <div
        id="companies-menu-panel"
        data-companies-menu-panel
        class="hidden absolute left-0 mt-2 w-[min(92vw,22rem)] rounded-xl border border-border-light dark:border-border-dark bg-surface-light/95 dark:bg-surface-dark/95 shadow-lg ring-1 ring-black/5 dark:ring-white/10 z-50"
        role="dialog"
        aria-label="Sort and filter companies"
      >
        <div class="p-4 space-y-4">
          <div>
            <label
              class="block text-xs font-semibold tracking-wide text-text-mutedLight dark:text-text-mutedDark mb-1"
              for="company-search"
            >
              Search
            </label>
            <input
              id="company-search"
              data-companies-search
              type="search"
              placeholder="Name, location, interview notes…"
              class="w-full rounded-md border border-border-light dark:border-border-dark bg-surface-muted px-3 py-2 text-sm text-text-light dark:text-text-dark placeholder:text-text-mutedLight/80 dark:placeholder:text-text-mutedDark/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            />
          </div>

          <div
            class="border-t border-border-light/70 dark:border-border-dark/70 pt-4"
          >
            <div
              class="text-xs font-semibold tracking-wide text-text-mutedLight dark:text-text-mutedDark mb-2"
            >
              Sort
            </div>
            <div class="grid gap-1" role="radiogroup" aria-label="Sort">
              <button
                type="button"
                data-companies-sort-option="name-asc"
                role="radio"
                aria-checked="true"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Company name (A–Z)</span>
                <span
                  data-companies-sort-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
              <button
                type="button"
                data-companies-sort-option="name-desc"
                role="radio"
                aria-checked="false"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Company name (Z–A)</span>
                <span
                  data-companies-sort-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
              <button
                type="button"
                data-companies-sort-option="employment"
                role="radio"
                aria-checked="false"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Employment type</span>
                <span
                  data-companies-sort-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
            </div>
          </div>

          <div
            class="border-t border-border-light/70 dark:border-border-dark/70 pt-4"
          >
            <div
              class="text-xs font-semibold tracking-wide text-text-mutedLight dark:text-text-mutedDark mb-2"
            >
              Employment type
            </div>
            <div class="grid gap-1" role="group" aria-label="Employment type">
              <button
                type="button"
                data-companies-employment-option="Remote"
                role="menuitemcheckbox"
                aria-checked="false"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Remote</span>
                <span
                  data-companies-employment-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
              <button
                type="button"
                data-companies-employment-option="Hybrid"
                role="menuitemcheckbox"
                aria-checked="false"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>Hybrid</span>
                <span
                  data-companies-employment-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
              <button
                type="button"
                data-companies-employment-option="In-office"
                role="menuitemcheckbox"
                aria-checked="false"
                class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <span>In-office</span>
                <span
                  data-companies-employment-check
                  aria-hidden="true"
                  class="text-accent hidden">✓</span
                >
              </button>
            </div>
          </div>

          <div
            class="border-t border-border-light/70 dark:border-border-dark/70 pt-4 flex items-center justify-end"
          >
            <button
              type="button"
              data-companies-reset
              class="cursor-pointer text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
            >
              Reset
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="inline-flex items-center rounded-lg border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-1"
      role="radiogroup"
      aria-label="Company view"
    >
      <button
        type="button"
        data-companies-view-button="card"
        role="radio"
        aria-checked="true"
        class="cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium text-text-light dark:text-text-dark hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Cards
      </button>
      <button
        type="button"
        data-companies-view-button="list"
        role="radio"
        aria-checked="false"
        class="cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium text-text-light dark:text-text-dark hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        List
      </button>
    </div>
  </div>

  <div class="flex items-center justify-between gap-3">
    <p
      class="text-sm text-text-mutedLight dark:text-text-mutedDark"
      data-companies-count
    >
      Showing {startIndex}–{endIndex} of {totalItems} companies
    </p>
    <div class="flex items-center gap-2">
      <span
        class="hidden sm:inline text-xs text-text-mutedLight dark:text-text-mutedDark"
      >
        Per page
      </span>
      <div class="inline-flex items-center">
        <div
          data-companies-per-page-group="card"
          class="rounded-lg border border-border-light dark:border-border-dark bg-surface-muted p-1"
          aria-label="Companies per page (grid)"
        >
          <button
            type="button"
            data-companies-per-page-option="12"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            12
          </button>
          <button
            type="button"
            data-companies-per-page-option="24"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            24
          </button>
          <button
            type="button"
            data-companies-per-page-option="48"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            48
          </button>
          <button
            type="button"
            data-companies-per-page-option="96"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            96
          </button>
        </div>
        <div
          data-companies-per-page-group="list"
          class="hidden rounded-lg border border-border-light dark:border-border-dark bg-surface-muted p-1"
          aria-label="Companies per page (list)"
        >
          <button
            type="button"
            data-companies-per-page-option="10"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            10
          </button>
          <button
            type="button"
            data-companies-per-page-option="25"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            25
          </button>
          <button
            type="button"
            data-companies-per-page-option="50"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            50
          </button>
          <button
            type="button"
            data-companies-per-page-option="100"
            class="cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            100
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    data-companies-view-panel="card"
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
  >
    {paginatedItems.map((company) => <CompanyCard company={company} />)}
  </div>

  <div data-companies-view-panel="list" class="hidden">
    <ul
      class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark divide-y divide-border-light dark:divide-border-dark md:grid md:gap-x-4 md:items-start md:grid-cols-[fit-content(18rem)_minmax(0,12rem)_minmax(0,1fr)_2.5rem]"
      aria-label="Companies"
    >
      {paginatedItems.map((company) => <CompanyListItem company={company} />)}
    </ul>
  </div>

  <div data-companies-client-pagination></div>
  <div data-companies-fallback-pagination>
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</section>

<script type="module" src={companiesViewToggleUrl} is:inline></script>
<script type="module" src={companiesBrowseClientUrl} is:inline></script>
