---
import BrowseToolbar from "./browse/BrowseToolbar.astro";
import BrowseViewToggle from "./browse/BrowseViewToggle.astro";
import BrowsePerPageControls from "./browse/BrowsePerPageControls.astro";
import BrowseResultsPanels from "./browse/BrowseResultsPanels.astro";
import BrowsePaginationControls from "./browse/BrowsePaginationControls.astro";
import BrowseTemplates from "./browse/BrowseTemplates.astro";
import type { Company } from "@data/types";

export interface Props {
  paginatedItems: Company[];
  totalPages: number;
  currentPage: number;
  totalItems: number;
  startIndex: number;
  endIndex: number;
  companiesViewToggleUrl: string;
  companiesBrowseClientUrl: string;
}

const {
  paginatedItems,
  totalPages,
  currentPage,
  totalItems,
  startIndex,
  endIndex,
  companiesViewToggleUrl,
  companiesBrowseClientUrl,
} = Astro.props as Props;

const toolbarProps = {
  searchInputProps: {
    "data-companies-search": true,
  },
  menuButtonProps: {
    "data-companies-menu-button": true,
    "aria-label": "Filter & sort",
    "aria-expanded": false,
    "aria-controls": "companies-menu-panel",
  },
};

const viewToggleProps = {
  cardButtonProps: {
    "data-companies-view-button": "card",
    role: "radio" as const,
    "aria-checked": true,
  },
  listButtonProps: {
    "data-companies-view-button": "list",
    role: "radio" as const,
    "aria-checked": false,
  },
};
---

<section
  id="companies"
  class="space-y-4"
  aria-live="polite"
  data-companies-view="card"
  data-companies-section
>
  <div data-companies-menu>
    <div
      class="hidden fixed inset-0 bg-black/20 dark:bg-black/50 backdrop-blur-[1px] z-30"
      aria-hidden="true"
      data-companies-menu-scrim
    >
    </div>

    <div data-companies-background>
      <div class="flex flex-nowrap items-center gap-3 min-w-0">
        <BrowseToolbar {...toolbarProps} />
        <BrowseViewToggle {...viewToggleProps} />
      </div>

      <div data-companies-browse-content class="mt-4">
        <BrowsePerPageControls
          startIndex={startIndex}
          endIndex={endIndex}
          totalItems={totalItems}
        />

        <BrowseResultsPanels paginatedItems={paginatedItems} />

        <BrowsePaginationControls
          currentPage={currentPage}
          totalPages={totalPages}
        />

        <BrowseTemplates />
      </div>
    </div>

    <div
      class="hidden fixed w-[min(92vw,22rem)] rounded-xl border border-border-light dark:border-border-dark bg-surface-light/95 dark:bg-surface-dark/95 shadow-lg ring-1 ring-black/5 dark:ring-white/10 z-50"
      role="dialog"
      aria-modal="true"
      aria-label="Filter and sort companies"
      tabindex="-1"
      id="companies-menu-panel"
      data-companies-menu-panel
    >
      <div class="p-4 space-y-4">
        <div class="pt-1">
          <div
            class="text-xs font-semibold tracking-wide text-text-mutedLight dark:text-text-mutedDark mb-2"
          >
            Sort
          </div>
          <div class="grid gap-1" role="radiogroup" aria-label="Sort">
            <button
              type="button"
              data-companies-sort-option="name-asc"
              role="radio"
              aria-checked="true"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Company name (A–Z)</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-sort-option="name-desc"
              role="radio"
              aria-checked="false"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Company name (Z–A)</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-sort-option="employment"
              role="radio"
              aria-checked="false"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Employment type</span>
              <span
                data-companies-sort-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
          </div>
        </div>

        <div
          class="border-t border-border-light/70 dark:border-border-dark/70 pt-4"
        >
          <div
            class="text-xs font-semibold tracking-wide text-text-mutedLight dark:text-text-mutedDark mb-2"
          >
            Employment type
          </div>
          <div class="grid gap-1" role="group" aria-label="Employment type">
            <button
              type="button"
              data-companies-employment-option="Remote"
              aria-pressed="false"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Remote</span>
              <span
                data-companies-employment-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-employment-option="Hybrid"
              aria-pressed="false"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Hybrid</span>
              <span
                data-companies-employment-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
            <button
              type="button"
              data-companies-employment-option="In-office"
              aria-pressed="false"
              class="cursor-pointer flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>In-office</span>
              <span
                data-companies-employment-check
                aria-hidden="true"
                class="text-accent hidden">✓</span
              >
            </button>
          </div>
        </div>

        <div
          class="border-t border-border-light/70 dark:border-border-dark/70 pt-4 flex items-center justify-end"
        >
          <button
            type="button"
            class="cursor-pointer text-sm text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
            data-companies-reset
          >
            Reset
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" src={companiesViewToggleUrl} is:inline></script>
<script type="module" src={companiesBrowseClientUrl} is:inline></script>
