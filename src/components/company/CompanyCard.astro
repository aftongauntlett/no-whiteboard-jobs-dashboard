---
import type { Company } from "@data/types";
import EmploymentBadge from "../ui/EmploymentBadge.astro";
import CurationIndicator from "../ui/CurationIndicator.astro";
import CompanyInterviewPreview from "./CompanyInterviewPreview.astro";
import { createInterviewId } from "../../utils/company";
import {
  COMPANY_CARD_EXTERNAL_ICON_CLASS,
  COMPANY_CARD_HEADER_CLASS,
  COMPANY_CARD_INTERACTIVE_CLASS,
  COMPANY_CARD_LINK_CLASS,
  COMPANY_CARD_NAME_HOVER_CLASS,
  COMPANY_CARD_STATIC_CLASS,
  COMPANY_CARD_TITLE_CLASS,
  COMPANY_CARD_TITLE_INLINE_CLASS,
} from "./companyStyles";

type Props = {
  company: Company;
};

const { company } = Astro.props as Props;
const interviewId = createInterviewId(company);
---

{
  company.careersUrl ? (
    <article
      class={COMPANY_CARD_INTERACTIVE_CLASS}
    >
      <a
        href={company.careersUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={COMPANY_CARD_LINK_CLASS}
        aria-label={`Open ${company.name} careers page in a new tab`}
      ></a>

      <div class="relative flex flex-col">
        <!-- Header -->
        <header class={COMPANY_CARD_HEADER_CLASS}>
          <div class="min-w-0 flex items-center gap-2">
            <h3
              class={COMPANY_CARD_TITLE_CLASS}
            >
              <span class={COMPANY_CARD_TITLE_INLINE_CLASS}>
                <span class={COMPANY_CARD_NAME_HOVER_CLASS}>
                  {company.name}
                </span>
                {
                  company.source === "local" ? (
                    <CurationIndicator status={company.curationStatus ?? "edited"} />
                  ) : null
                }
              </span>
            </h3>
            <EmploymentBadge employmentType={company.employmentType} />
          </div>

          <!-- Reserved top-right slot for hover icon -->
          <span
            class={COMPANY_CARD_EXTERNAL_ICON_CLASS}
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M14 3h7v7" />
              <path d="M10 14L21 3" />
              <path d="M21 14v7h-7" />
              <path d="M3 10v11h11" />
            </svg>
          </span>
        </header>

        <!-- Interview process -->
        <CompanyInterviewPreview
          interviewProcessHtml={company.interviewProcessHtml}
          interviewId={interviewId}
          variant="card"
          locations={company.locations}
        />
      </div>
    </article>
  ) : (
    <article
      class={COMPANY_CARD_STATIC_CLASS}
    >
      <header class={COMPANY_CARD_HEADER_CLASS}>
        <div class="min-w-0 flex items-center gap-2">
          <h3
            class={COMPANY_CARD_TITLE_CLASS}
          >
            <span class={COMPANY_CARD_TITLE_INLINE_CLASS}>
              <span>{company.name}</span>
              {
                company.source === "local" ? (
                  <CurationIndicator status={company.curationStatus ?? "edited"} />
                ) : null
              }
            </span>
          </h3>
          <EmploymentBadge employmentType={company.employmentType} />
        </div>
      </header>

      <CompanyInterviewPreview
        interviewProcessHtml={company.interviewProcessHtml}
        interviewId={interviewId}
        variant="card"
        locations={company.locations}
      />
    </article>
  )
}
