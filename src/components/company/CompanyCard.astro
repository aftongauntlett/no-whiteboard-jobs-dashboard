---
import type { Company } from "@data/types";
import EmploymentBadge from "../ui/EmploymentBadge.astro";
import CurationIndicator from "../ui/CurationIndicator.astro";
import CompanyLocations from "./CompanyLocations.astro";
import CompanyInterviewPreview from "./CompanyInterviewPreview.astro";
import { createInterviewId } from "../../utils/company";

type Props = {
  company: Company;
};

const { company } = Astro.props as Props;
const interviewId = createInterviewId(company);
---

{
  company.careersUrl ? (
    <article
      class="company-card company-card--interactive group relative focus-within:ring-2 focus-within:ring-accent/30 focus-within:ring-offset-2 focus-within:ring-offset-bg-light dark:focus-within:ring-offset-bg-dark"
    >
      <a
        href={company.careersUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0 z-20 rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
        aria-label={`Open ${company.name} careers page in a new tab`}
      ></a>

      <div class="relative flex flex-col">
        <!-- Header -->
        <header class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex items-center gap-2">
            <h3
              class="text-base font-semibold leading-tight text-text-light dark:text-text-dark min-w-0"
            >
              <span class="inline-flex items-center gap-2 min-w-0">
                <span class="group-hover:text-accent">
                  {company.name}
                </span>
                {
                  company.source === "local" ? (
                    <CurationIndicator status={company.curationStatus ?? "edited"} />
                  ) : null
                }
              </span>
            </h3>
            <EmploymentBadge employmentType={company.employmentType} />
          </div>

          <!-- Reserved top-right slot for hover icon -->
          <span
            class="invisible inline-flex h-8 w-8 items-center justify-center rounded-md text-accent opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M14 3h7v7" />
              <path d="M10 14L21 3" />
              <path d="M21 14v7h-7" />
              <path d="M3 10v11h11" />
            </svg>
          </span>
        </header>

        <!-- Locations -->
        <CompanyLocations
          locations={company.locations}
          class="mt-0.5 flex flex-wrap gap-2"
        />

        <!-- Interview process -->
        <CompanyInterviewPreview
          interviewProcessHtml={company.interviewProcessHtml}
          interviewId={interviewId}
          variant="card"
        />
      </div>
    </article>
  ) : (
    <article
      class="company-card group"
    >
      <header class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex items-center gap-2">
          <h3
            class="text-base font-semibold leading-tight text-text-light dark:text-text-dark min-w-0"
          >
            <span class="inline-flex items-center gap-2 min-w-0">
              <span>{company.name}</span>
              {
                company.source === "local" ? (
                  <CurationIndicator status={company.curationStatus ?? "edited"} />
                ) : null
              }
            </span>
          </h3>
          <EmploymentBadge employmentType={company.employmentType} />
        </div>
      </header>

      <CompanyLocations
        locations={company.locations}
        class="mt-0.5 flex flex-wrap gap-2"
      />

      <CompanyInterviewPreview
        interviewProcessHtml={company.interviewProcessHtml}
        interviewId={interviewId}
        variant="card"
      />
    </article>
  )
}
