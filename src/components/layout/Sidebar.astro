---
import NavLinks from "./NavLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Sun from "lucide-astro/Sun";
import Moon from "lucide-astro/Moon";
import ChevronLeft from "lucide-astro/ChevronLeft";
---

<aside
  id="sidebar"
  class="w-56 shrink-0 sticky top-0 h-screen bg-bg-light dark:bg-bg-dark border-r border-border-light dark:border-border-dark text-text-light dark:text-text-dark overflow-hidden"
>
  <div class="h-full flex flex-col px-4 pt-6 pb-7.5" data-sidebar-container>
    <div class="flex-1 min-h-0 overflow-y-auto" data-sidebar-scroll>
      <!-- Header / branding -->
      <a
        href="/"
        class="mb-8 flex items-center gap-3 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <div class="leading-tight sidebar-text">
          <div class="text-sm font-semibold">No Whiteboard Jobs</div>
          <div class="text-xs text-text-mutedLight dark:text-text-mutedDark">
            Dashboard
          </div>
        </div>
      </a>

      <!-- Divider -->
      <div
        class="mx-2 border-t border-border-light/80 dark:border-border-dark/80 mb-4"
      >
      </div>

      <!-- Primary navigation -->
      <NavLinks variant="sidebar" />
    </div>

    <!-- Bottom actions (pinned) -->
    <div class="pt-4" data-sidebar-footer>
      <!-- Theme toggle -->
      <ThemeToggle
        id="theme-toggle"
        class="flex self-stretch items-center justify-start gap-2 rounded p-2 border border-border-light dark:border-border-dark text-text-light dark:text-text-dark cursor-pointer hover:bg-surface-light/10 dark:hover:bg-surface-dark/10 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <Moon class="h-4 w-4 dark:hidden" aria-hidden="true" />
        <Sun class="h-4 w-4 hidden dark:block" aria-hidden="true" />

        <span class="text-sm sidebar-text dark:hidden">Dark Mode</span>
        <span class="text-sm sidebar-text hidden dark:inline">Light Mode</span>
      </ThemeToggle>

      <div
        class="mx-2 border-t border-border-light/80 dark:border-border-dark/80 mt-4"
      >
      </div>
      <!-- Collapse toggle -->
      <button
        id="sidebar-toggle"
        type="button"
        aria-label="Toggle sidebar"
        class="mt-4 flex items-center justify-between w-full rounded p-2 text-text-mutedLight dark:text-text-mutedDark cursor-pointer
               hover:text-accent dark:hover:text-accent
               hover:bg-surface-light dark:hover:bg-surface-dark
               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <ChevronLeft class="h-4 w-4" aria-hidden="true" />
        <span class="sidebar-text text-sm">Collapse</span>
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  // Sidebar collapse functionality
  const sidebar = document.getElementById("sidebar");
  const toggleButton = document.getElementById("sidebar-toggle");
  const chevronIcon = toggleButton?.querySelector("svg");
  const sidebarTexts = sidebar?.querySelectorAll(".sidebar-text") ?? [];
  const sidebarContainer = sidebar?.querySelector("[data-sidebar-container]");
  const themeToggle = document.getElementById("theme-toggle");

  if (
    !sidebar ||
    !toggleButton ||
    !chevronIcon ||
    !sidebarContainer ||
    !themeToggle
  ) {
    // Missing expected sidebar elements; skip collapse wiring.
  } else {
    let isCollapsed = false;

    toggleButton.addEventListener("click", () => {
      isCollapsed = !isCollapsed;

      if (isCollapsed) {
        sidebar.classList.remove("w-56");
        sidebar.classList.add("w-16", "collapsed");
        sidebarContainer.classList.remove("px-4");
        sidebarContainer.classList.add("px-2");
        chevronIcon.innerHTML = '<path d="m9 18 6-6-6-6"></path>';
        sidebarTexts.forEach((text) => text.classList.add("!hidden"));
        themeToggle.classList.add("icon-only");
        themeToggle.classList.remove("justify-start");
        themeToggle.classList.add("justify-center");
      } else {
        sidebar.classList.remove("w-16", "collapsed");
        sidebar.classList.add("w-56");
        sidebarContainer.classList.remove("px-2");
        sidebarContainer.classList.add("px-4");
        chevronIcon.innerHTML = '<path d="m15 18-6-6 6-6"></path>';
        sidebarTexts.forEach((text) => text.classList.remove("!hidden"));
        themeToggle.classList.remove("icon-only");
        themeToggle.classList.add("justify-start");
        themeToggle.classList.remove("justify-center");
      }

      // Store collapsed state
      localStorage.setItem("sidebar-collapsed", isCollapsed.toString());
    });

    // Initialize from localStorage
    const storedCollapsed =
      localStorage.getItem("sidebar-collapsed") === "true";
    if (storedCollapsed) {
      isCollapsed = true;
      sidebar.classList.remove("w-56");
      sidebar.classList.add("w-16", "collapsed");
      sidebarContainer.classList.remove("px-4");
      sidebarContainer.classList.add("px-2");
      chevronIcon.innerHTML = '<path d="m9 18 6-6-6-6"></path>';
      sidebarTexts.forEach((text) => text.classList.add("!hidden"));
      themeToggle.classList.add("icon-only");
      themeToggle.classList.remove("justify-start");
      themeToggle.classList.add("justify-center");
    }
  }
</script>

<style>
  .icon-only {
    border: 0;
    padding: 0.25rem;
  }
  .icon-only:hover {
    background: transparent;
  }

  #sidebar.collapsed nav a {
    justify-content: center;
    border-left-width: 0;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  #sidebar.collapsed nav a svg {
    margin-right: 0;
  }

  #sidebar.collapsed [data-sidebar-scroll] > a:first-child {
    justify-content: center;
  }

  #sidebar.collapsed #theme-toggle {
    gap: 0;
    width: 100%;
  }

  #sidebar.collapsed #sidebar-toggle {
    justify-content: center;
  }
</style>
