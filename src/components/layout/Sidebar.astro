---
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path;
import Search from "lucide-astro/Search";
import Lightbulb from "lucide-astro/Lightbulb";
import HelpCircle from "lucide-astro/HelpCircle";
import Sun from "lucide-astro/Sun";
import Moon from "lucide-astro/Moon";
import ChevronLeft from "lucide-astro/ChevronLeft";
---

<aside
  id="sidebar"
  class="w-56 shrink-0 bg-bg-light dark:bg-bg-dark border-r border-border-light dark:border-border-dark text-text-light dark:text-text-dark"
>
  <div class="h-full flex flex-col px-4 pt-6 pb-4">
    <!-- Header / branding -->
    <a
      href="/"
      class="mb-8 flex items-center gap-3 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      <!-- Logo placeholder -->
      <div
        class="h-8 w-8 rounded bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark flex items-center justify-center text-xs font-semibold"
        aria-hidden="true"
      >
        NW
      </div>

      <div class="leading-tight sidebar-text">
        <div class="text-sm font-semibold">No Whiteboard Jobs</div>
        <div class="text-xs text-text-mutedLight dark:text-text-mutedDark">
          Dashboard
        </div>
      </div>
    </a>

    <!-- Divider -->
    <div
      class="mx-2 border-t border-border-light/80 dark:border-border-dark/80 mb-4"
    >
    </div>

    <!-- Primary navigation -->
    <nav aria-label="Primary navigation">
      <ul class="space-y-1">
        <li>
          <a
            href="/"
            aria-current={isActive("/") ? "page" : undefined}
            class={`group flex items-center rounded px-3 py-2 text-sm font-medium
              border-l-2
              ${
                isActive("/")
                  ? "border-accent text-accent bg-surface-light dark:bg-surface-dark"
                  : "border-transparent text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark hover:bg-surface-light dark:hover:bg-surface-dark"
              }
              focus:outline-none focus-visible:ring-2 focus-visible:ring-accent`}
          >
            <Search class="h-4 w-4 mr-2" aria-hidden="true" />
            <span class="sidebar-text">Browse companies</span>
          </a>
        </li>

        <li>
          <a
            href="/hiring-tips"
            aria-current={isActive("/hiring-tips") ? "page" : undefined}
            class={`group flex items-center rounded px-3 py-2 text-sm font-medium
              border-l-2
              ${
                isActive("/hiring-tips")
                  ? "border-accent text-accent bg-surface-light dark:bg-surface-dark"
                  : "border-transparent text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark hover:bg-surface-light dark:hover:bg-surface-dark"
              }
              focus:outline-none focus-visible:ring-2 focus-visible:ring-accent`}
          >
            <Lightbulb class="h-4 w-4 mr-2" aria-hidden="true" />
            <span class="sidebar-text">Hiring tips</span>
          </a>
        </li>

        <li>
          <a
            href="/about"
            aria-current={isActive("/about") ? "page" : undefined}
            class={`group flex items-center rounded px-3 py-2 text-sm font-medium
              border-l-2
              ${
                isActive("/about")
                  ? "border-accent text-accent bg-surface-light dark:bg-surface-dark"
                  : "border-transparent text-text-mutedLight dark:text-text-mutedDark hover:text-text-light dark:hover:text-text-dark hover:bg-surface-light dark:hover:bg-surface-dark"
              }
              focus:outline-none focus-visible:ring-2 focus-visible:ring-accent`}
          >
            <HelpCircle class="h-4 w-4 mr-2" aria-hidden="true" />
            <span class="sidebar-text">About</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Bottom actions -->
    <div class="mt-auto pt-4">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="ml-auto flex items-center justify-end gap-2 rounded p-2 border border-border-light dark:border-border-dark text-text-light dark:text-text-dark cursor-pointer
               hover:bg-surface-light/10 dark:hover:bg-surface-dark/10 hover:text-accent
               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <!-- Sun icon (light mode) -->
        <Sun class="h-4 w-4 dark:hidden" aria-hidden="true" />

        <!-- Moon icon (dark mode) -->
        <Moon class="h-4 w-4 hidden dark:block" aria-hidden="true" />

        <span class="text-sm dark:hidden sidebar-text">Light Mode</span>
        <span class="text-sm hidden dark:block sidebar-text">Dark Mode</span>
      </button>

      <div
        class="mx-2 border-t border-border-light/80 dark:border-border-dark/80 mt-4"
      >
      </div>
      <!-- Collapse toggle -->
      <button
        id="sidebar-toggle"
        type="button"
        aria-label="Toggle sidebar"
        class="mt-4 flex items-center justify-between w-full rounded p-2 text-text-mutedLight dark:text-text-mutedDark cursor-pointer
               hover:text-accent dark:hover:text-accent
               hover:bg-surface-light dark:hover:bg-surface-dark
               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <ChevronLeft class="h-4 w-4" aria-hidden="true" />
        <span class="sidebar-text text-sm">Collapse</span>
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  const button = document.getElementById("theme-toggle");

  if (button) {
    const root = document.documentElement;

    button.setAttribute(
      "aria-pressed",
      root.classList.contains("dark") ? "true" : "false",
    );

    button.addEventListener("click", () => {
      // Layout initializes theme CSS variables and exposes helpers.
      // Use them so the visual theme actually changes (not just the class).
      let nextTheme;
      if (typeof window.__toggleTheme === "function") {
        nextTheme = window.__toggleTheme();
      } else {
        const isDark = root.classList.contains("dark");
        nextTheme = isDark ? "light" : "dark";
        root.classList.toggle("dark", nextTheme === "dark");
        try {
          localStorage.setItem("theme", nextTheme);
        } catch {
          // ignore
        }
      }

      // aria-pressed reflects whether dark mode is active
      button.setAttribute("aria-pressed", (nextTheme === "dark").toString());
    });
  }

  // Sidebar collapse functionality
  const sidebar = document.getElementById("sidebar");
  const toggleButton = document.getElementById("sidebar-toggle");
  const chevronIcon = toggleButton.querySelector("svg");
  const sidebarTexts = document.querySelectorAll(".sidebar-text");
  const sidebarContainer = sidebar.querySelector("div");
  const themeToggle = document.getElementById("theme-toggle");

  let isCollapsed = false;

  toggleButton.addEventListener("click", () => {
    isCollapsed = !isCollapsed;

    if (isCollapsed) {
      sidebar.classList.remove("w-56");
      sidebar.classList.add("w-16", "collapsed");
      sidebarContainer.classList.remove("px-4");
      sidebarContainer.classList.add("px-2");
      chevronIcon.innerHTML = '<path d="m9 18 6-6-6-6"></path>';
      sidebarTexts.forEach((text) => text.classList.add("!hidden"));
      themeToggle.classList.add("icon-only");
      themeToggle.classList.remove("ml-auto", "justify-end");
      themeToggle.classList.add("justify-center");
    } else {
      sidebar.classList.remove("w-16", "collapsed");
      sidebar.classList.add("w-56");
      sidebarContainer.classList.remove("px-2");
      sidebarContainer.classList.add("px-4");
      chevronIcon.innerHTML = '<path d="m15 18-6-6 6-6"></path>';
      sidebarTexts.forEach((text) => text.classList.remove("!hidden"));
      themeToggle.classList.remove("icon-only");
      themeToggle.classList.add("ml-auto", "justify-end");
      themeToggle.classList.remove("justify-center");
    }

    // Store collapsed state
    localStorage.setItem("sidebar-collapsed", isCollapsed.toString());
  });

  // Initialize from localStorage
  const storedCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
  if (storedCollapsed) {
    isCollapsed = true;
    sidebar.classList.remove("w-56");
    sidebar.classList.add("w-16", "collapsed");
    sidebarContainer.classList.remove("px-4");
    sidebarContainer.classList.add("px-2");
    chevronIcon.innerHTML = '<path d="m9 18 6-6-6-6"></path>';
    sidebarTexts.forEach((text) => text.classList.add("!hidden"));
    themeToggle.classList.add("icon-only");
    themeToggle.classList.remove("ml-auto", "justify-end");
    themeToggle.classList.add("justify-center");
  }
</script>

<style>
  .icon-only {
    border: 0;
    padding: 0.25rem;
  }
  .icon-only:hover {
    background: transparent;
  }

  #sidebar.collapsed nav a {
    justify-content: center;
    border-left-width: 0;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  #sidebar.collapsed nav a svg {
    margin-right: 0;
  }

  #sidebar.collapsed > div > a:first-child {
    justify-content: center;
  }

  #sidebar.collapsed #theme-toggle {
    gap: 0;
    width: 100%;
  }

  #sidebar.collapsed #sidebar-toggle {
    justify-content: center;
  }
</style>
