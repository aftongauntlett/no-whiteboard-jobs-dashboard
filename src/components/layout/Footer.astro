---
const year = new Date().getFullYear();
const portfolioUrl = "https://www.aftongauntlett.com/";
---

<footer>
  <div class="app-container">
    <div
      class="mx-2 border-t border-border-light/80 dark:border-border-dark/80"
    >
      <div class="py-6 grid gap-4 md:grid-cols-3 md:items-center">
        <nav aria-label="Footer navigation" class="md:justify-self-start">
          <ul
            class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-mutedLight dark:text-text-mutedDark"
          >
            <li>
              <a
                href="/"
                class="underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >Browse Companies</a
              >
            </li>
            <li>
              <a
                href="/hiring-tips"
                class="underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >Hiring Tips</a
              >
            </li>
            <li>
              <a
                href="/about"
                class="underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >About</a
              >
            </li>
          </ul>
        </nav>

        <p
          class="text-xs text-text-mutedLight dark:text-text-mutedDark md:justify-self-center md:text-center"
        >
          © {year}
          <a
            href={portfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >Afton Gauntlett</a
          >
        </p>

        <div class="flex items-center gap-4 md:justify-self-end">
          <button
            type="button"
            data-scroll-top
            class="cursor-pointer inline-flex items-center justify-center rounded-full border border-border-light dark:border-border-dark bg-surface-light/70 dark:bg-surface-dark/60 px-4 py-2 text-xs text-text-light dark:text-text-dark shadow-sm hover:bg-surface-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label="Scroll to top"
          >
            ↑ Top
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const btn = document.querySelector("[data-scroll-top]");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const prefersReducedMotion = window.matchMedia?.(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      window.scrollTo({
        top: 0,
        left: 0,
        behavior: prefersReducedMotion ? "auto" : "smooth",
      });
    });
  })();
</script>
