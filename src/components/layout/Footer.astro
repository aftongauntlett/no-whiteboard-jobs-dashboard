---
import Button from "../ui/Button.astro";
import NavLinks from "./NavLinks.astro";
const year = new Date().getFullYear();
const portfolioUrl = "https://www.aftongauntlett.com/";
---

<footer>
  <div class="app-container">
    <div
      class="mx-2 border-t border-border-light/80 dark:border-border-dark/80"
    >
      <div class="py-6 grid gap-4 md:grid-cols-3 md:items-center">
        <NavLinks variant="footer" />

        <p
          class="text-xs text-text-mutedLight dark:text-text-mutedDark md:justify-self-center md:text-center"
        >
          © {year}
          <a
            href={portfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-4 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >Afton Gauntlett</a
          >
        </p>

        <div class="flex items-center gap-4 md:justify-self-end">
          <Button
            type="button"
            variant="secondary"
            style="soft"
            shape="pill"
            size="sm"
            data-scroll-top
            aria-label="Scroll to top"
            class="cursor-pointer px-4 py-2 text-xs"
          >
            ↑ Top
          </Button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const btn = document.querySelector("[data-scroll-top]");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const prefersReducedMotion = window.matchMedia?.(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      window.scrollTo({
        top: 0,
        left: 0,
        behavior: prefersReducedMotion ? "auto" : "smooth",
      });
    });
  })();
</script>
